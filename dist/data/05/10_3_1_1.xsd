<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_10_3_1_1="urn:pl:oire:unk_10_3_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_10_3_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.3.1.1. Zapytanie o obiekt                                                                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityCharacteristicRequest" type="unk_10_3_1_1:FacilityCharacteristicRequest"/>
    <xs:complexType name="FacilityCharacteristicRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_1:plName>10.3.1.1. Zapytanie o obiekt</unk_10_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Nagłówek</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-700</unk_10_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Kontekst</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-715</unk_10_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 10.3.1.1. Payload Zapytanie o obiekt -->
            <xs:element name="Payload" type="unk_10_3_1_1:FacilityCharacteristicRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>10.3.1.1. Payload Zapytanie o obiekt</unk_10_3_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.3.1.1. Payload Zapytanie o obiekt                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityCharacteristicRequestPayload" type="unk_10_3_1_1:FacilityCharacteristicRequestPayload"/>
    <xs:complexType name="FacilityCharacteristicRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_1:plName>10.3.1.1. Payload Zapytanie o obiekt</unk_10_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_10_3_1_1:FacilityData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Dane obiektu - ogólne</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-425</unk_10_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_10_3_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Pozostałe elementy komunikatu</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-320</unk_10_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_10_3_1_1:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_1:plName>Dane obiektu - ogólne</unk_10_3_1_1:plName>
                <unk_10_3_1_1:code>PL-425</unk_10_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Identyfikator obiektu</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-424</unk_10_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_10_3_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_1:plName>Pozostałe elementy komunikatu</unk_10_3_1_1:plName>
                <unk_10_3_1_1:code>PL-320</unk_10_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data charakterystyki -->
            <xs:element name="CharacteristicDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_1:plName>Data charakterystyki</unk_10_3_1_1:plName>
                        <unk_10_3_1_1:code>PL-171</unk_10_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dzień, za który ma zostać udostępniona charakterystyka PP lub charakterystyka obiektu, wskazany przez nadawcę komunikatu. Nie może dotyczyć zapytań "w przód".</xs:documentation>
                    <xs:documentation xml:lang="en">The day for which the MP characteristics or facility characteristics are to be made available, as indicated by the sender of the message. May not apply to inquiries ''forward''."</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>