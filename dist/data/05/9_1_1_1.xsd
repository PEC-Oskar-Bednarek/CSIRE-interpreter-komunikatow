                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Szczegóły komunikatu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-324</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Roczne plany mocy -->
            <xs:element name="AnnualPowerPlans" type="unk_9_1_1_1:AnnualPowerPlans" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Roczne plany mocy</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-429</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 6.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Kategoria zgłoszenia                                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RequestCategory" type="unk_9_1_1_1:RequestCategory"/>
    <xs:complexType name="RequestCategory">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Kategoria zgłoszenia</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-329</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kategoria komunikatu -->
            <xs:element name="GenericInformationExchangeReason" type="bdt:GenericInformationExchangeReasonType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Kategoria komunikatu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-258</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodna ze słownikiem Kategorie wymiany informacji.</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the table Categories of information exchange.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_9_1_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Dane PP - ogólne</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-300</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Kod PP</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-001</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Identyfikator obiektu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-424</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Adresat komunikatu                                                                                                                           ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MessageRecipient" type="unk_9_1_1_1:MessageRecipient"/>
    <xs:complexType name="MessageRecipient">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Adresat komunikatu</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-336</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ wnioskowanego adresata komunikatu -->
            <xs:element name="RecipientType" type="bdt:ComplaintRecipientType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Typ wnioskowanego adresata komunikatu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-177</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Typ Użytkownika profesjonalnego, do którego powinna zostać przekazany komunikat.</xs:documentation>
                    <xs:documentation xml:lang="en">The type of Professional User to which the message should be forwarded.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ID adresata komunikatu jest znane? -->
            <xs:element name="IsRecipientIdKnown" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Czy ID adresata komunikatu jest znane?</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-369</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy nadawca komunikatu wie, do którego Użytkownika profesjonalnego komunikat powinien zostać zaadresowany.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the sender of the message knows to which Professional User the message should be addressed.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_9_1_1_1:MeteringPointData_Operators" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Dane PP - podmioty obsługujące PP</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-303</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_9_1_1_1:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Dane PP - podmioty obsługujące PP</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-303</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_OIRE -->
            <xs:element name="OireIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_OIRE</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-141</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący operatora informacji rynku energii - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the energy market information operator - according to EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_Operator -->
            <xs:element name="OperatorIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_Operator</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-017</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Operatora, który utworzył oraz administruje PP. Kod identyfikacyjny zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Identification code of the Operator who created and administers the MP. Identification code in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_SE</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-019</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_POB -->
            <xs:element name="BalanceResponsiblePartyIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_POB</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-021</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący podmiot odpowiedzialny za bilansowanie handlowe - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the balance responsible party - in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_biznesowa_rola_adresata -->
            <xs:element name="RecipientBusinessRoleIdentifier" type="bdt:SenderRoleType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_biznesowa_rola_adresata</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-723</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Rola pełniona przez adresata, zgodna z Harmonised Electricity Market Role Model.</xs:documentation>
                    <xs:documentation xml:lang="en">The role performed by the recipient, according to the Harmonised Electricity Market Role Model.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Basic" type="unk_9_1_1_1:KseUserData_Basic"/>
    <xs:complexType name="KseUserData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Dane Użytkownika KSE - ogólne</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-395</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy wiele podmiotów? -->
            <xs:element name="HasMultipleEntities" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Czy wiele podmiotów?</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-400</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do Punktu pomiarowego ma być przypisany więcej niż jeden podmiot (osoba fizyczna lub prawna).</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether more than one entity (individual or legal entity) is to be assigned to a Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - podstawowe -->
            <xs:element name="KseUserData_Primary" type="unk_9_1_1_1:KseUserData_Primary" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Dane Użytkownika KSE - podstawowe</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-311</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - podstawowe                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Primary" type="unk_9_1_1_1:KseUserData_Primary"/>
    <xs:complexType name="KseUserData_Primary">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Dane Użytkownika KSE - podstawowe</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-311</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ Użytkownika KSE -->
            <xs:element name="KseUserType" type="bdt:KseUserType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Typ Użytkownika KSE</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-024</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu Użytkownika KSE wprowadzonego do Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of the KSE User entered in the Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - identyfikacyjne -->
            <xs:element name="KseUserData_Identifiers" type="unk_9_1_1_1:KseUserData_Identifiers" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-312</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - identyfikacyjne                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Identifiers" type="unk_9_1_1_1:KseUserData_Identifiers"/>
    <xs:complexType name="KseUserData_Identifiers">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-312</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>PESEL</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-028</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer PESEL identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">PESEL number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- NIP -->
            <xs:element name="Nip" type="bdt:NipType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>NIP</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-029</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer NIP identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">NIP number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- KRS -->
            <xs:element name="Krs" type="bdt:KrsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>KRS</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-030</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer KRS identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">KRS number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ identyfikatora -->
            <xs:element name="IdentifierType" type="bdt:UserIdentifierType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Typ identyfikatora</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-032</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sposób nadania identyfikatora osobie fizycznej nierezydent lub rezydent bez PESEL.</xs:documentation>
                    <xs:documentation xml:lang="en">The method of assigning an identifier to an individual non-resident or resident without PESEL.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Inny identyfikator osoby fizycznej -->
            <xs:element name="CustomKseUserIdentifier" type="bdt:IdentityDocumentNumberType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Inny identyfikator osoby fizycznej</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-033</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator użytkownika, dla którego nie jest znany PESEL. W przypadku nadania numeru przez Operatora, struktura identyfikatora powinna wyglądać następująco: [EIC] [UKSE] [UNIKATOWE_DOPEŁNIENIE_W_FORMACIE_12345678901]</xs:documentation>
                    <xs:documentation xml:lang="en">Identification for a KSE user without PESEL. The identifier structure should look as follows: [EIC] [UKSE] [UNIQUE_ADDENDUM_IN_FORMAT_12345678901].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Global NIP -->
            <xs:element name="GlobalTaxIdentification" type="bdt:GlobalTaxIdentificationType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Global NIP</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-034</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer identyfikujący użytkownika typu jednostka organizacyjna nieposiadająca numeru NIP, w tym nierezydent.</xs:documentation>
                    <xs:documentation xml:lang="en">Number identifying the user of the type organizational entity without NIP identifier (e.g. non-resident).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Szczegóły komunikatu                                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MessageDetails" type="unk_9_1_1_1:MessageDetails"/>
    <xs:complexType name="MessageDetails">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Szczegóły komunikatu</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-324</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_reklamowanego_procesu -->
            <xs:element name="ComplaintSubjectProcessId" type="bdt:UuidType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_reklamowanego_procesu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-230</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Standard nadawania kodów instancji procesów.</xs:documentation>
                    <xs:documentation xml:lang="en">Standard for assigning process instance codes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_reklamowanego_komunikatu -->
            <xs:element name="ComplaintSubjectMessageId" type="bdt:UuidType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>ID_reklamowanego_komunikatu</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-242</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">UUID nadawany przez system nadawcy, którego dotyczy zgłaszana reklamacja.</xs:documentation>
                    <xs:documentation xml:lang="en">The UUID assigned by the sender's system to which the claim is being made.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data -->
            <xs:element name="Date" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Data</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-264</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data, której dotyczy zgłaszana komunikat. Atrybut niezbędny wyłącznie na potrzeby walidacji historycznej charakterystyki PP - szczegółowy zakres dat, których dotyczy reklamacja należy podać w atrybucie Opis.</xs:documentation>
                    <xs:documentation xml:lang="en">The date to which the reported message applies. Attribute necessary only for the purpose of validating the historical characteristics of the MP - the detailed range of dates to which the claim applies should be provided in the Description attribute.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wnioskowany do uruchomienia proces -->
            <xs:element name="RequestedProcessType" type="bdt:BusinessProcessForRetroactiveExecutionType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Wnioskowany do uruchomienia proces</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-486</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wskazanie, który proces planowany jest do uruchomienia z datą wsteczną w sposób niestandardowy.</xs:documentation>
                    <xs:documentation xml:lang="en">Indication of which process is scheduled to run retroactively in a non-standard manner.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wnioskowana wsteczna data realizacji -->
            <xs:element name="RequestedRetroactiveExecutionDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Wnioskowana wsteczna data realizacji</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-487</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, na jaką datę planowane jest zgłoszenie danego procesu z datą wsteczną.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of what date the notification of a given process is planned to be retroactively executed for.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna potrzeby daty wstecznej -->
            <xs:element name="RetroactiveExecutionReason" type="bdt:RetroactiveExecutionReasonType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Przyczyna potrzeby daty wstecznej</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-488</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie przyczyny potrzeby przekazania komunikatu z datą wsteczną.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the reason for the need for a retroactive message.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Opis -->
            <xs:element name="Description" type="bdt:String2000_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Opis</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-263</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Opis słowny komunikatu - maksymalnie 2000 znaków.</xs:documentation>
                    <xs:documentation xml:lang="en">Verbal description of the message - maximum 2000 characters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Żądanie zgłoszenia zawartej UD -->
            <xs:element name="IsDistributionAgreementReportRequested" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Żądanie zgłoszenia zawartej UD</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-484</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Sprzedawca oczekuje zgłoszenia zawartej przez odbiorcę umowy dystrybucyjnej w związku z zawarciem umowy sprzedaży.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the Energy Supplier expects notification of the customer's concluded distribution agreement in connection with the conclusion of a supply agreement.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Oczekiwana data wejścia w życie umowy -->
            <xs:element name="PlannedAgreementValidFrom" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Oczekiwana data wejścia w życie umowy</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-485</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Oczekiwana przez Sprzedawcę data wejścia w życie umowy do zgłoszenia przez Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Energy Supplier's expected effective date of the agreement to be notified by the Operator.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy proces z inicjatywy klienta? -->
            <xs:element name="IsKseUserInitiatedProcess" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Czy proces z inicjatywy klienta?</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-489</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy zgłoszenie nastąpiło na skutek prośby Użytkownika KSE.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether this Information Exchange was requested by KSE User.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
