    <!-- ====================================================================================================================================================== -->
    <!-- ==== 9.1.1.1. Payload Żądanie wymiany informacji                                                                                                  ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="GenericInformationRequestPayload" type="unk_9_1_1_1:GenericInformationRequestPayload"/>
    <xs:complexType name="GenericInformationRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>9.1.1.1. Payload Żądanie wymiany informacji</unk_9_1_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Kategoria zgłoszenia -->
            <xs:element name="RequestCategory" type="unk_9_1_1_1:RequestCategory" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Kategoria zgłoszenia</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-329</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_9_1_1_1:MeteringPointData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Dane PP - ogólne</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-300</unk_9_1_1_1:code>
