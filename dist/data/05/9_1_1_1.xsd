    <xs:element name="AnnualPowerPlans" type="unk_9_1_1_1:AnnualPowerPlans"/>
    <xs:complexType name="AnnualPowerPlans">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_1:plName>Roczne plany mocy</unk_9_1_1_1:plName>
                <unk_9_1_1_1:code>PL-429</unk_9_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 6.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Sezonowość mocy -->
            <xs:element name="PowerSeasonality" type="bdt:String100_Type" minOccurs="0" maxOccurs="12">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_1:plName>Sezonowość mocy</unk_9_1_1_1:plName>
                        <unk_9_1_1_1:code>PL-430</unk_9_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie sezonowości mocy dla umów kompleksowych z podziałem na miesiące.</xs:documentation>
                    <xs:documentation xml:lang="en">Per-month power seasonality specification for comprehensive agreements.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
