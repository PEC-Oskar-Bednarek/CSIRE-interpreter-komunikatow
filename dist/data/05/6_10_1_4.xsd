<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_10_1_4="urn:pl:oire:unk_6_10_1_4:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_10_1_4:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.10.1.4. Powiadomienie o nowym rozliczeniu dodatkowym                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="NewAdditionalSettlementNotification" type="unk_6_10_1_4:NewAdditionalSettlementNotification"/>
    <xs:complexType name="NewAdditionalSettlementNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>6.10.1.4. Powiadomienie o nowym rozliczeniu dodatkowym</unk_6_10_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Nagłówek</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-700</unk_6_10_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Kontekst</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-715</unk_6_10_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.10.1.4. Payload Powiadomienie o nowym rozliczeniu dodatkowym -->
            <xs:element name="Payload" type="unk_6_10_1_4:NewAdditionalSettlementNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>6.10.1.4. Payload Powiadomienie o nowym rozliczeniu dodatkowym</unk_6_10_1_4:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.10.1.4. Payload Powiadomienie o nowym rozliczeniu dodatkowym                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="NewAdditionalSettlementNotificationPayload" type="unk_6_10_1_4:NewAdditionalSettlementNotificationPayload"/>
    <xs:complexType name="NewAdditionalSettlementNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>6.10.1.4. Payload Powiadomienie o nowym rozliczeniu dodatkowym</unk_6_10_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Rekord operacji masowej -->
            <xs:element name="NewAdditionalSettlement" type="unk_6_10_1_4:NewAdditionalSettlement" minOccurs="1" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Rekord operacji masowej</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-711</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Rekord operacji masowej                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="NewAdditionalSettlement" type="unk_6_10_1_4:NewAdditionalSettlement"/>
    <xs:complexType name="NewAdditionalSettlement">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>Rekord operacji masowej</unk_6_10_1_4:plName>
                <unk_6_10_1_4:code>PL-711</unk_6_10_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator transakcji -->
            <xs:element name="ReferenceTransactionId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Identyfikator transakcji</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-710</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator rekordu nadawany przez Operatora, używany do korelacji rekordu żądania do rekordu wyniku</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier assigned by Operator, used for batch record identification</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="unk_6_10_1_4:DataSubject" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Przedmiot danych</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-160</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_6_10_1_4:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Informacje podstawowe</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-325</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Przedmiot danych                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="DataSubject" type="unk_6_10_1_4:DataSubject"/>
    <xs:complexType name="DataSubject">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>Przedmiot danych</unk_6_10_1_4:plName>
                <unk_6_10_1_4:code>PL-160</unk_6_10_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="bdt:DataSubjectType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Przedmiot danych</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-161</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa, czy przekazywane lub udostępniane dane pomiarowe dotyczą Punktu pomiarowego, czy obiektu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether the transferred or shared metering data pertains to a Metering Point or a Metering Facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_6_10_1_4:MeteringPointData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Dane PP - ogólne</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-300</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_6_10_1_4:FacilityData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Dane obiektu - ogólne</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-425</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_6_10_1_4:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>Dane PP - ogólne</unk_6_10_1_4:plName>
                <unk_6_10_1_4:code>PL-300</unk_6_10_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Kod PP</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-001</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_6_10_1_4:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>Dane obiektu - ogólne</unk_6_10_1_4:plName>
                <unk_6_10_1_4:code>PL-425</unk_6_10_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Identyfikator obiektu</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-424</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_6_10_1_4:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_4:plName>Informacje podstawowe</unk_6_10_1_4:plName>
                <unk_6_10_1_4:code>PL-325</unk_6_10_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_transakcji_nadawcy -->
            <xs:element name="SenderReferenceTransactionId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>ID_transakcji_nadawcy</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-236</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">UUID transakcji z danymi pomiarowymi, przekazanego przez Operatora do CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">UUID of the metering data transaction transmitted by the Operator to CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data i czas dokonania rozliczenia -->
            <xs:element name="BillingDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_4:plName>Data i czas dokonania rozliczenia</unk_6_10_1_4:plName>
                        <unk_6_10_1_4:code>PL-178</unk_6_10_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data i czas dokonania rozliczenia.</xs:documentation>
                    <xs:documentation xml:lang="en">Date and time of billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>