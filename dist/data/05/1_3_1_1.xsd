<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_1_3_1_1="urn:pl:oire:unk_1_3_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_1_3_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 1.3.1.1. Powiadomienie o uruchomieniu sprzedaży rezerwowej                                                                                   ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ReserveEnergySupplyActivationNotification" type="unk_1_3_1_1:ReserveEnergySupplyActivationNotification"/>
    <xs:complexType name="ReserveEnergySupplyActivationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>1.3.1.1. Powiadomienie o uruchomieniu sprzedaży rezerwowej</unk_1_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nagłówek</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-700</unk_1_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kontekst</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-715</unk_1_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 1.3.1.1. Payload Powiadomienie o uruchomieniu sprzedaży rezerwowej -->
            <xs:element name="Payload" type="unk_1_3_1_1:ReserveEnergySupplyActivationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>1.3.1.1. Payload Powiadomienie o uruchomieniu sprzedaży rezerwowej</unk_1_3_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 1.3.1.1. Payload Powiadomienie o uruchomieniu sprzedaży rezerwowej                                                                           ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ReserveEnergySupplyActivationNotificationPayload" type="unk_1_3_1_1:ReserveEnergySupplyActivationNotificationPayload"/>
    <xs:complexType name="ReserveEnergySupplyActivationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>1.3.1.1. Payload Powiadomienie o uruchomieniu sprzedaży rezerwowej</unk_1_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_1_3_1_1:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane PP - ogólne</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-300</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_1_3_1_1:MeteringPointData_Operators" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane PP - podmioty obsługujące PP</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-303</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - ogólne -->
            <xs:element name="KseUserData_Basic" type="unk_1_3_1_1:KseUserData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane Użytkownika KSE - ogólne</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-395</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - podstawowe -->
            <xs:element name="KseUserData_Primary" type="unk_1_3_1_1:KseUserData_Primary" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane Użytkownika KSE - podstawowe</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-311</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_1_3_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Pozostałe elementy komunikatu</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-320</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_1_3_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane PP - ogólne</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-300</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kod PP</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-001</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_1_3_1_1:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane PP - podmioty obsługujące PP</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-303</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>ID_SE</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-019</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Basic" type="unk_1_3_1_1:KseUserData_Basic"/>
    <xs:complexType name="KseUserData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane Użytkownika KSE - ogólne</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-395</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy nabywca końcowy? -->
            <xs:element name="IsEndBuyer" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy nabywca końcowy?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-392</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownik KSE jest nabywcą końcowym w rozumieniu przepisów.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the KSE User is a final buyer as defined by the regulations.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy odbiorca końcowy? -->
            <xs:element name="IsEndUser" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy odbiorca końcowy?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-393</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownik KSE jest odbiorcą końcowym w rozumieniu przepisów.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the KSE User is a final user as defined by the regulations.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy wiele podmiotów? -->
            <xs:element name="HasMultipleEntities" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy wiele podmiotów?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-400</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do Punktu pomiarowego ma być przypisany więcej niż jeden podmiot (osoba fizyczna lub prawna).</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether more than one entity (individual or legal entity) is to be assigned to a Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - adresowe -->
            <xs:element name="KseUserData_Address" type="unk_1_3_1_1:KseUserData_Address" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane Użytkownika KSE - adresowe</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-313</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - korespondencyjne -->
            <xs:element name="KseUserData_MailingAddress" type="unk_1_3_1_1:KseUserData_MailingAddress" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane Użytkownika KSE - korespondencyjne</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-314</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - adresowe                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Address" type="unk_1_3_1_1:KseUserData_Address"/>
    <xs:complexType name="KseUserData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane Użytkownika KSE - adresowe</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-313</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kraj</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-037</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Miejscowość</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-038</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości</xs:documentation>
                    <xs:documentation xml:lang="en">Name of city</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy zastosowano podział na ulice?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-559</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu Użytkownika KSE w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this KSE User address.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy ulica zgodna z TERYT?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-585</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kod pocztowy</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-039</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Ulica</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-040</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr budynku</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-041</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu/ mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr lokalu/ mieszkania</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-042</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr działki</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-043</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>TERYT</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-044</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - korespondencyjne                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_MailingAddress" type="unk_1_3_1_1:KseUserData_MailingAddress"/>
    <xs:complexType name="KseUserData_MailingAddress">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane Użytkownika KSE - korespondencyjne</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-314</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Nazwa adresata -->
            <xs:element name="RecipientName" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nazwa adresata</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-054</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa adresata dla adresu do korespondencji</xs:documentation>
                    <xs:documentation xml:lang="en">Addressee name for mailing address</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kraj</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-045</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Miejscowość</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-046</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości</xs:documentation>
                    <xs:documentation xml:lang="en">Name of city</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy zastosowano podział na ulice?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-560</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu Użytkownika KSE w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this KSE User address.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Czy ulica zgodna z TERYT?</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-586</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Kod pocztowy</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-047</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Ulica</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-048</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr budynku</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-049</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu/ mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr lokalu/ mieszkania</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-050</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nr działki</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-051</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>TERYT</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-052</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - podstawowe                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Primary" type="unk_1_3_1_1:KseUserData_Primary"/>
    <xs:complexType name="KseUserData_Primary">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane Użytkownika KSE - podstawowe</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-311</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ Użytkownika KSE -->
            <xs:element name="KseUserType" type="bdt:KseUserType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Typ Użytkownika KSE</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-024</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu Użytkownika KSE wprowadzonego do Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of the KSE User entered in the Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Imię -->
            <xs:element name="FirstName" type="bdt:String50_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Imię</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-025</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Pierwsze imię użytkownika</xs:documentation>
                    <xs:documentation xml:lang="en">First name of the user</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nazwisko -->
            <xs:element name="LastName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nazwisko</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-026</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwisko użytkownika</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nazwa -->
            <xs:element name="CompanyName" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Nazwa</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-027</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa użytkownika</xs:documentation>
                    <xs:documentation xml:lang="en">User name</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - identyfikacyjne -->
            <xs:element name="KseUserData_Identifiers" type="unk_1_3_1_1:KseUserData_Identifiers" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-312</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - identyfikacyjne                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Identifiers" type="unk_1_3_1_1:KseUserData_Identifiers"/>
    <xs:complexType name="KseUserData_Identifiers">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_3_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_1_3_1_1:plName>
                <unk_1_3_1_1:code>PL-312</unk_1_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>PESEL</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-028</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer PESEL identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">PESEL number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- NIP -->
            <xs:element name="Nip" type="bdt:NipType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>NIP</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-029</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer NIP identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">NIP number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- KRS -->
            <xs:element name="Krs" type="bdt:KrsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>KRS</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-030</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer KRS identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">KRS number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ identyfikatora -->
            <xs:element name="IdentifierType" type="bdt:UserIdentifierType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Typ identyfikatora</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-032</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sposób nadania identyfikatora osobie fizycznej nierezydent lub rezydent bez PESEL.</xs:documentation>
                    <xs:documentation xml:lang="en">The method of assigning an identifier to an individual non-resident or resident without PESEL.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Inny identyfikator osoby fizycznej -->
            <xs:element name="CustomKseUserIdentifier" type="bdt:IdentityDocumentNumberType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Inny identyfikator osoby fizycznej</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-033</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator użytkownika, dla którego nie jest znany PESEL. W przypadku nadania numeru przez Operatora, struktura identyfikatora powinna wyglądać następująco: [EIC] [UKSE] [UNIKATOWE_DOPEŁNIENIE_W_FORMACIE_12345678901]</xs:documentation>
                    <xs:documentation xml:lang="en">Identification for a KSE user without PESEL. The identifier structure should look as follows: [EIC] [UKSE] [UNIQUE_ADDENDUM_IN_FORMAT_12345678901].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Global NIP -->
            <xs:element name="GlobalTaxIdentification" type="bdt:GlobalTaxIdentificationType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Global NIP</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-034</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer identyfikujący użytkownika typu jednostka organizacyjna nieposiadająca numeru NIP, w tym nierezydent.</xs:documentation>
                    <xs:documentation xml:lang="en">Number identifying the user of the type organizational entity without NIP identifier (e.g. non-resident).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
