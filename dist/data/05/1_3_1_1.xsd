            <xs:element name="FirstDayWithoutSupplierInMeteringPointDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_3_1_1:plName>Data, od której brak SE w Ch-ce PP</unk_1_3_1_1:plName>
                        <unk_1_3_1_1:code>PL-158</unk_1_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dzień, od którego w charakterystyce PP nie widnieje Sprzedawca energii elektrycznej.</xs:documentation>
                    <xs:documentation xml:lang="en">The day from which there is no energy Supplier in the characteristics of the MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
