    <!-- ====================================================================================================================================================== -->
    <!-- ==== 11.1.1.3. Udostępnienie historycznego dobowego profilu zużycia                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="HistoricalCorrectionForDailyMeteringPointMeasurementsForwardNotification" type="unk_11_1_1_3:HistoricalCorrectionForDailyMeteringPointMeasurementsForwardNotification"/>
    <xs:complexType name="HistoricalCorrectionForDailyMeteringPointMeasurementsForwardNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_1_1_3:plName>11.1.1.3. Udostępnienie historycznego dobowego profilu zużycia</unk_11_1_1_3:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_1_1_3:plName>Nagłówek</unk_11_1_1_3:plName>
                        <unk_11_1_1_3:code>PL-700</unk_11_1_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_1_1_3:plName>Kontekst</unk_11_1_1_3:plName>
                        <unk_11_1_1_3:code>PL-715</unk_11_1_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 11.1.1.3. Payload Udostępnienie historycznego dobowego profilu zużycia -->
            <xs:element name="Payload" type="unk_11_1_1_3:HistoricalCorrectionForDailyMeteringPointMeasurementsForwardNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_1_1_3:plName>11.1.1.3. Payload Udostępnienie historycznego dobowego profilu zużycia</unk_11_1_1_3:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
