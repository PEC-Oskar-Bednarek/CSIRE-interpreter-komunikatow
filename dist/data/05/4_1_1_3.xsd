<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_4_1_1_3="urn:pl:oire:unk_4_1_1_3:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_4_1_1_3:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.1.1.3. Powiadomienie o statusie PP                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointStatusNotification" type="unk_4_1_1_3:MeteringPointStatusNotification"/>
    <xs:complexType name="MeteringPointStatusNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>4.1.1.3. Powiadomienie o statusie PP</unk_4_1_1_3:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Nagłówek</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-700</unk_4_1_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Kontekst</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-715</unk_4_1_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 4.1.1.3. Payload Powiadomienie o statusie PP -->
            <xs:element name="Payload" type="unk_4_1_1_3:MeteringPointStatusNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>4.1.1.3. Payload Powiadomienie o statusie PP</unk_4_1_1_3:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.1.1.3. Payload Powiadomienie o statusie PP                                                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointStatusNotificationPayload" type="unk_4_1_1_3:MeteringPointStatusNotificationPayload"/>
    <xs:complexType name="MeteringPointStatusNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>4.1.1.3. Payload Powiadomienie o statusie PP</unk_4_1_1_3:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_4_1_1_3:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Pozostałe elementy komunikatu</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-320</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_4_1_1_3:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Dane PP - ogólne</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-300</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - ogólne -->
            <xs:element name="TechnicalData_Basic" type="unk_4_1_1_3:TechnicalData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Parametry techniczne - ogólne</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-304</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - ogólne -->
            <xs:element name="BusinessData_Basic" type="unk_4_1_1_3:BusinessData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Parametry handlowe - ogólne</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-316</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_4_1_1_3:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>Pozostałe elementy komunikatu</unk_4_1_1_3:plName>
                <unk_4_1_1_3:code>PL-320</unk_4_1_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>ID_instancji_procesu_referencyjnego</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-002</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przypisanie SE -->
            <xs:element name="HasAssignedSupplier" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Przypisanie SE</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-164</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Atrybut wynikający z aktualnej charakterystyki PP. Wskazuje czy dla danego PP przypisany jest Sprzedawca energii elektrycznej.</xs:documentation>
                    <xs:documentation xml:lang="en">Attribute derived from the current characteristics of the MP. Indicates whether an Energy Supplier is assigned for a given MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przypisanie Użytkownika KSE -->
            <xs:element name="HasAssignedKseUser" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Przypisanie Użytkownika KSE</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-165</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Atrybut wynikający z aktualnej charakterystyki PP. Wskazuje czy dla danego PP przypisany jest Użytkownik KSE.</xs:documentation>
                    <xs:documentation xml:lang="en">Attribute resulting from current MP characteristics. Indicates whether an KSE User is assigned for a given MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_4_1_1_3:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>Dane PP - ogólne</unk_4_1_1_3:plName>
                <unk_4_1_1_3:code>PL-300</unk_4_1_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Kod PP</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-001</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ Punktu pomiarowego -->
            <xs:element name="MeteringPointType" type="bdt:MeteringPointType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Typ Punktu pomiarowego</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-053</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu Punktu pomiarowego, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the Metering Point type, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Charakter PPE -->
            <xs:element name="MpApType" type="bdt:MpApType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Charakter PPE</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-056</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie charakteru Punktu poboru energii, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the nature of the Energy Consumption Point, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Charakter PPI -->
            <xs:element name="MpOtherType" type="bdt:MpOtherType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Charakter PPI</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-419</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie charakteru Punktu pomiarowego inny, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the nature of the Metering Point other, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy PP podrzędny względem innego PP? -->
            <xs:element name="IsChildMp" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Czy PP podrzędny względem innego PP?</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-418</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy wskazany Punkt pomiarowy jest autonomiczny, czy jest podrzędny względem innego Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the indicated Metering Point is autonomous or is subordinate to another Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy PP wchodzi w skład obiektu? -->
            <xs:element name="IsMpPartOfFacility" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Czy PP wchodzi w skład obiektu?</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-421</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dany Punkt pomiarowy jest elementem obiektu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of whether a given Metering Point is part of a metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - obiekt -->
            <xs:element name="MeteringPointData_Facility" type="unk_4_1_1_3:MeteringPointData_Facility" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Dane PP - obiekt</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-422</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - adresowe -->
            <xs:element name="MeteringPointData_Address" type="unk_4_1_1_3:MeteringPointData_Address" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Dane PP - adresowe</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-301</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - obiekt                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Facility" type="unk_4_1_1_3:MeteringPointData_Facility"/>
    <xs:complexType name="MeteringPointData_Facility">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>Dane PP - obiekt</unk_4_1_1_3:plName>
                <unk_4_1_1_3:code>PL-422</unk_4_1_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ obiektu -->
            <xs:element name="FacilityType" type="bdt:FacilityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Typ obiektu</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-423</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu obiektu, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the facility type, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - adresowe                                                                                                                           ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Address" type="unk_4_1_1_3:MeteringPointData_Address"/>
    <xs:complexType name="MeteringPointData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>Dane PP - adresowe</unk_4_1_1_3:plName>
                <unk_4_1_1_3:code>PL-301</unk_4_1_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Miejscowość</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-004</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości (właściwa dla Punktu pomiarowego).</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the city (specific to the Metering Point).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Czy ulica zgodna z TERYT?</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-584</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:PostalCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Kod pocztowy</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-005</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Ulica</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-006</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Nr budynku</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-007</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu / mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Nr lokalu / mieszkania</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-008</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Nr działki</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-009</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry techniczne - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="TechnicalData_Basic" type="unk_4_1_1_3:TechnicalData_Basic"/>
    <xs:complexType name="TechnicalData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_1_1_3:plName>Parametry techniczne - ogólne</unk_4_1_1_3:plName>
                <unk_4_1_1_3:code>PL-304</unk_4_1_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data obowiązywania warunków przyłączeniowych -->
            <xs:element name="DateOfValidityOfTheConnectionConditions" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_1_1_3:plName>Data obowiązywania warunków przyłączeniowych</unk_4_1_1_3:plName>
                        <unk_4_1_1_3:code>PL-098</unk_4_1_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określana jedynie dla VI gr. przyłączeniowej, wskazuje ostatni dzień warunków przyłączenia.</xs:documentation>
                    <xs:documentation xml:lang="en">Specified only for the VI connection gr. and indicates the last day of the connection conditions.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - licznik -->
