<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_4_3_1_1="urn:pl:oire:unk_4_3_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_4_3_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.3.1.1. Żądanie charakterystyki PP                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointCharacteristicRequest" type="unk_4_3_1_1:MeteringPointCharacteristicRequest"/>
    <xs:complexType name="MeteringPointCharacteristicRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_3_1_1:plName>4.3.1.1. Żądanie charakterystyki PP</unk_4_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Nagłówek</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-700</unk_4_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Kontekst</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-715</unk_4_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 4.3.1.1. Payload Żądanie charakterystyki PP -->
            <xs:element name="Payload" type="unk_4_3_1_1:MeteringPointCharacteristicRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>4.3.1.1. Payload Żądanie charakterystyki PP</unk_4_3_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.3.1.1. Payload Żądanie charakterystyki PP                                                                                                  ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointCharacteristicRequestPayload" type="unk_4_3_1_1:MeteringPointCharacteristicRequestPayload"/>
    <xs:complexType name="MeteringPointCharacteristicRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_3_1_1:plName>4.3.1.1. Payload Żądanie charakterystyki PP</unk_4_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_4_3_1_1:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Dane PP - ogólne</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-300</unk_4_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_4_3_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Pozostałe elementy komunikatu</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-320</unk_4_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_4_3_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_3_1_1:plName>Dane PP - ogólne</unk_4_3_1_1:plName>
                <unk_4_3_1_1:code>PL-300</unk_4_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Kod PP</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-001</unk_4_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_4_3_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_3_1_1:plName>Pozostałe elementy komunikatu</unk_4_3_1_1:plName>
                <unk_4_3_1_1:code>PL-320</unk_4_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data charakterystyki -->
            <xs:element name="CharacteristicDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_3_1_1:plName>Data charakterystyki</unk_4_3_1_1:plName>
                        <unk_4_3_1_1:code>PL-171</unk_4_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dzień, za który ma zostać udostępniona charakterystyka PP lub charakterystyka obiektu, wskazany przez nadawcę komunikatu. Nie może dotyczyć zapytań "w przód".</xs:documentation>
                    <xs:documentation xml:lang="en">The day for which the MP characteristics or facility characteristics are to be made available, as indicated by the sender of the message. May not apply to inquiries ''forward''."</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>