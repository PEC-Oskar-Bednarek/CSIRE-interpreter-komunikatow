    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry handlowe - dodatkowe US/UK                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BusinessData_SupplyAndComplexAgreement" type="unk_2_7_1_1:BusinessData_SupplyAndComplexAgreement"/>
    <xs:complexType name="BusinessData_SupplyAndComplexAgreement">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_7_1_1:plName>Parametry handlowe - dodatkowe US/UK</unk_2_7_1_1:plName>
                <unk_2_7_1_1:code>PL-319</unk_2_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 5.3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Warunki produktu -->
            <xs:element name="ProductTerms" type="bdt:ProductTermsType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Warunki produktu</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-495</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie warunków umowy zawartej z odbiorcą:
CK0715 - oznacza wyłącznie taryfę, która jest zatwierdzana przez Prezesa Urzędu Regulacji Energetyki;
CK0716 - oznacza specjalny cennik wykorzystywany wobec konsumentów znajdujących się w trudnej sytuacji materialnej;
CK0717 - oznacza taryfę standardową lub podstawowy cennik sprzedawcy, który nie jest zatwierdzany przez Prezesa Urzędu Regulacji Energetyki;
CK0718 - oznacza ofertę, zgodnie z którą przez określony czas cena energii nie ulegnie zmianie;
CK0719 - oznacza ofertę, zgodnie z którą część energii rozliczana jest po cenie stałej, a część - po cenie zmiennej;
CK0720 - oznacza ofertę opartą o ceny rynku spot;
CK0721 - oznacza ofertę opartą o średnią cenę rynku hurtowego w określonym czasie;
CK0722 - oznacza ofertę, zgodnie z którą cena za energię może ulegać zmianie, ale do określonego limitu;
CK0723 - oznacza ofertę opartą o taryfę zatwierdzaną lub cennik standardowy z dodatkowym upustem procentowym;
CK0724 - oznacza ofertę, zgodnie z którą zużyta energia pochodzi z odnawialnych źródeł energii lub jest kompensowana gwarancjami pochodzenia;
CK0725 - oznacza ofertę, dotyczącą pochodzenia energii ze źródeł innych, niż odnawialne;
CK0726 - oznacza ofertę, na podstawie której Użytkownik KSE otrzymuje dodatkowe korzyści od Sprzedawcy (np. w formie usług dodatkowych, bonów zakupowych, itp.);
CK0727 - oznacza inną ofertę, niewymienioną w powyższych.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the terms of the agreement concluded with the customer.
CK0715 - means only the tariff that is approved by the President of the Energy Regulatory Authority;
CK0716 - means a special price list used with regard to financially disadvantaged consumers;
CK0717 - means the supplier's standard tariff or basic price list that is not approved by the President of the Energy Regulatory Authority;
CK0718 - means an offer according to which the price of energy will not change for a certain period of time;
CK0719 - means an offer according to which part of the energy is billed at a fixed price and part is billed at a variable price;
CK0720 - means an offer based on spot market prices;
CK0721 - means an offer based on the average price of the wholesale market over a specified period of time;
CK0722 - means an offer according to which the price for energy may change, but up to a certain limit;
CK0723 - means an offer based on an approved tariff or standard price list with an additional percentage discount;
CK0724 - means an offer according to which the energy consumed comes from renewable energy sources or is offset by guarantees of origin;
CK0725 - means an offer, according to which the energy originates from non-renewable sources;
CK0726 - means an offer pursuant to which the KSE User receives additional benefits from the Supplier (e.g., in the form of additional services, purchase vouchers, etc.);
CK0727 - means any other offer not mentioned in the above.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nazwa produktu -->
            <xs:element name="ProductName" type="bdt:String100_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Nazwa produktu</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-343</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa produktu, zgodna ze słownikiem SE.</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the product, in accordance with the ES dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Opis produktu -->
            <xs:element name="ProductDescription" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Opis produktu</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-344</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zwięzły opis szczegółowych warunków wpływających na rozliczenie odbiorcy.</xs:documentation>
                    <xs:documentation xml:lang="en">Concise description of the detailed conditions affecting the billing of the customer.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Terminowość produktu -->
            <xs:element name="EndDateType" type="bdt:EndDateType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Terminowość produktu</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-133</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy umowa zawiera produkt terminowy w postaci np. preferencyjnych warunków cenowych.</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether the agreement includes a term product in the form of, for example, preferential pricing terms.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przewidywana data zakończenia produktu -->
            <xs:element name="ExpectedEndDate" type="xs:date" minOccurs="0" maxOccurs="1">
