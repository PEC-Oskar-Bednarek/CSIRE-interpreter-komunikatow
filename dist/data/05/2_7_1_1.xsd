                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Zgoda na udostępnienie rzeczywistego profilu zużycia SE</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-067</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgoda wyrażona przez odbiorcę na rzecz Sprzedawcy lub wynikająca z regulacji prawnych dotycząca udostępniania rzeczywistego profilu zużycia energii elektrycznej dla PPE. Dotyczy tylko przypadków, gdy Użytkownikiem KSE jest Odbiorca jako osoba fizyczna.</xs:documentation>
                    <xs:documentation xml:lang="en">Consent expressed by the customer to the Energy Supplier or resulting from legal regulations regarding the release of the actual electricity consumption profile for the PPE. Applies only when the KSE User is the Customer as an individual.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Możliwość wstrzymania windykacyjnego -->
            <xs:element name="CanBeSuspendedForDebtCollection" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Możliwość wstrzymania windykacyjnego</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-055</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego Punktu poboru energii dopuszczalne jest wstrzymywanie dostaw energii.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether withholding of energy supply is allowed for a given Energy Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - warunki świadczenia usług -->
            <xs:element name="BusinessData_TermsOfService" type="unk_2_7_1_1:BusinessData_TermsOfService" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Parametry handlowe - warunki świadczenia usług</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-321</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - umowa dystrybucyjna/przesyłowa -->
            <xs:element name="BusinessData_DistributionAgreement" type="unk_2_7_1_1:BusinessData_DistributionAgreement" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Parametry handlowe - umowa dystrybucyjna/przesyłowa</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-317</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - umowa kompleksowa -->
            <xs:element name="BusinessData_ComplexAgreement" type="unk_2_7_1_1:BusinessData_ComplexAgreement" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Parametry handlowe - umowa kompleksowa</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-322</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
