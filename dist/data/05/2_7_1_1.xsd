    <xs:complexType name="BusinessData_ComplexAgreement">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_7_1_1:plName>Parametry handlowe - umowa kompleksowa</unk_2_7_1_1:plName>
                <unk_2_7_1_1:code>PL-322</unk_2_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 5.3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
