    <xs:element name="KseUserData_Identifiers" type="unk_2_7_1_1:KseUserData_Identifiers"/>
    <xs:complexType name="KseUserData_Identifiers">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_7_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_2_7_1_1:plName>
                <unk_2_7_1_1:code>PL-312</unk_2_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>PESEL</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-028</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer PESEL identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">PESEL number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- NIP -->
            <xs:element name="Nip" type="bdt:NipType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>NIP</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-029</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer NIP identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">NIP number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- KRS -->
            <xs:element name="Krs" type="bdt:KrsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
