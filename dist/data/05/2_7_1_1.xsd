                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wskazanie, czy umowa kompleksowa została zawarta na określony czas.</xs:documentation>
                    <xs:documentation xml:lang="en">Indication of whether the comprehensive agreement was concluded for a specified period of time.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Termin zakończenia określony w umowie -->
            <xs:element name="ExpectedEndDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Termin zakończenia określony w umowie</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-274</unk_2_7_1_1:code>
                    </xs:appinfo>
