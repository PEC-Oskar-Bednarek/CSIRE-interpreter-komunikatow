                </xs:annotation>
            </xs:element>
            
            <!-- Okres wypowiedzenia -->
            <xs:element name="NoticePeriod" type="bdt:String30_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Okres wypowiedzenia</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-272</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Okres wypowiedzenia UK</xs:documentation>
                    <xs:documentation xml:lang="en">Termination period UK</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Terminowość -->
            <xs:element name="EndDateType" type="bdt:EndDateType_Type" minOccurs="1" maxOccurs="1">
