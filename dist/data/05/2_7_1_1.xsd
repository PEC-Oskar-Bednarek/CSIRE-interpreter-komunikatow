                        <unk_2_7_1_1:code>PL-275</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Okres rozliczeniowy usług dystrybucji - zgodny z okresem rozliczeniowym Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Billing period for distribution services - consistent with the Operator's billing period.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Okres rozliczeniowy sprzedawcy -->
            <xs:element name="SupplierBillingPeriod" type="bdt:String100_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Okres rozliczeniowy sprzedawcy</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-342</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Okres rozliczeniowy dot. umowy obrotu.</xs:documentation>
                    <xs:documentation xml:lang="en">Billing period regarding the trading agreement.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Funkcja przedpłaty -->
            <xs:element name="HasPrepayment" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Funkcja przedpłaty</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-173</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego PP sprzedawca świadczy usługę kompleksową na zasadach przedpłaty.</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether, for a given MP, the supplier provides comprehensive service on a prepaid basis.</xs:documentation>
                </xs:annotation>
