            <xs:element name="StartDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_7_1_1:plName>Data rozpoczęcia</unk_2_7_1_1:plName>
                        <unk_2_7_1_1:code>PL-271</unk_2_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data przypisania UK do charakterystyki PP.</xs:documentation>
