<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_2_5_1_1="urn:pl:oire:unk_2_5_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_2_5_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.5.1.1. Powiadomienie o OŚW                                                                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="StatementOfWillNotification" type="unk_2_5_1_1:StatementOfWillNotification"/>
    <xs:complexType name="StatementOfWillNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>2.5.1.1. Powiadomienie o OŚW</unk_2_5_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Nagłówek</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-700</unk_2_5_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Kontekst</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-715</unk_2_5_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.5.1.1. Payload Powiadomienie o OŚW -->
            <xs:element name="Payload" type="unk_2_5_1_1:StatementOfWillNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>2.5.1.1. Payload Powiadomienie o OŚW</unk_2_5_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.5.1.1. Payload Powiadomienie o OŚW                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="StatementOfWillNotificationPayload" type="unk_2_5_1_1:StatementOfWillNotificationPayload"/>
    <xs:complexType name="StatementOfWillNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>2.5.1.1. Payload Powiadomienie o OŚW</unk_2_5_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_2_5_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Pozostałe elementy komunikatu</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-320</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_5_1_1:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane PP - ogólne</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-300</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_2_5_1_1:MeteringPointData_Operators" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane PP - podmioty obsługujące PP</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-303</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - ogólne -->
            <xs:element name="KseUserData_Basic" type="unk_2_5_1_1:KseUserData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane Użytkownika KSE - ogólne</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-395</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - podstawowe -->
            <xs:element name="KseUserData_Primary" type="unk_2_5_1_1:KseUserData_Primary" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane Użytkownika KSE - podstawowe</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-311</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - umowa dystrybucyjna/przesyłowa -->
            <xs:element name="BusinessData_DistributionAgreement" type="unk_2_5_1_1:BusinessData_DistributionAgreement" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Parametry handlowe - umowa dystrybucyjna/przesyłowa</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-317</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 6.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_5_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>Pozostałe elementy komunikatu</unk_2_5_1_1:plName>
                <unk_2_5_1_1:code>PL-320</unk_2_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>ID_instancji_procesu_referencyjnego</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-002</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu nadawany przez CSIRE dla uruchomionego procesu 1.1.</xs:documentation>
                    <xs:documentation xml:lang="en">Unique process instance code assigned by CSIRE for the running process 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacja o OŚW -->
            <xs:element name="StatementOfWill" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Informacja o OŚW</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-163</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Oświadczenie Sprzedawcy o posiadaniu oświadczenia woli Odbiorcy o umocowaniu do zawarcia UD.</xs:documentation>
                    <xs:documentation xml:lang="en">The Energy Supplier's statement of possession of the Customer's statement of will to enter into a UD.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_5_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>Dane PP - ogólne</unk_2_5_1_1:plName>
                <unk_2_5_1_1:code>PL-300</unk_2_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Kod PP</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-001</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_2_5_1_1:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>Dane PP - podmioty obsługujące PP</unk_2_5_1_1:plName>
                <unk_2_5_1_1:code>PL-303</unk_2_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>ID_SE</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-019</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Basic" type="unk_2_5_1_1:KseUserData_Basic"/>
    <xs:complexType name="KseUserData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>Dane Użytkownika KSE - ogólne</unk_2_5_1_1:plName>
                <unk_2_5_1_1:code>PL-395</unk_2_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy nabywca końcowy? -->
            <xs:element name="IsEndBuyer" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy nabywca końcowy?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-392</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownik KSE jest nabywcą końcowym w rozumieniu przepisów.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the KSE User is a final buyer as defined by the regulations.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy odbiorca końcowy? -->
            <xs:element name="IsEndUser" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy odbiorca końcowy?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-393</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownik KSE jest odbiorcą końcowym w rozumieniu przepisów.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the KSE User is a final user as defined by the regulations.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy posiada prawo do odstąpienia od umowy? -->
            <xs:element name="HasAgreementTerminationRights" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy posiada prawo do odstąpienia od umowy?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-394</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownikowi KSE przysługuje prawo do odstąpienia od umowy o świadczenie usług dystrybucji zawartej na podstawie OŚW.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of whether the KSE User is entitled to withdraw from the distribution service agreement entered into under the Statement of Will.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy wiele podmiotów? -->
            <xs:element name="HasMultipleEntities" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy wiele podmiotów?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-400</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do Punktu pomiarowego ma być przypisany więcej niż jeden podmiot (osoba fizyczna lub prawna).</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether more than one entity (individual or legal entity) is to be assigned to a Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - adresowe -->
            <xs:element name="KseUserData_Address" type="unk_2_5_1_1:KseUserData_Address" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane Użytkownika KSE - adresowe</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-313</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - korespondencyjne -->
            <xs:element name="KseUserData_MailingAddress" type="unk_2_5_1_1:KseUserData_MailingAddress" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Dane Użytkownika KSE - korespondencyjne</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-314</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - adresowe                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Address" type="unk_2_5_1_1:KseUserData_Address"/>
    <xs:complexType name="KseUserData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_1:plName>Dane Użytkownika KSE - adresowe</unk_2_5_1_1:plName>
                <unk_2_5_1_1:code>PL-313</unk_2_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Kraj</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-037</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Miejscowość</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-038</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości</xs:documentation>
                    <xs:documentation xml:lang="en">Name of city</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy zastosowano podział na ulice?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-559</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu Użytkownika KSE w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this KSE User address.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Czy ulica zgodna z TERYT?</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-585</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Kod pocztowy</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-039</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Ulica</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-040</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Nr budynku</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-041</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu/ mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_1:plName>Nr lokalu/ mieszkania</unk_2_5_1_1:plName>
                        <unk_2_5_1_1:code>PL-042</unk_2_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
