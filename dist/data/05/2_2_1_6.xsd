<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_2_2_1_6="urn:pl:oire:unk_2_2_1_6:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_2_2_1_6:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.6. Powiadomienie o możliwości aktualizacji danych w charakterystyce PP                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationValidationResult" type="unk_2_2_1_6:MeteringPointModificationValidationResult"/>
    <xs:complexType name="MeteringPointModificationValidationResult">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_6:plName>2.2.1.6. Powiadomienie o możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Nagłówek</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-700</unk_2_2_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Kontekst</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-715</unk_2_2_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.2.1.6. Payload Powiadomienie o możliwości aktualizacji danych w charakterystyce PP -->
            <xs:element name="Payload" type="unk_2_2_1_6:MeteringPointModificationValidationResultPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>2.2.1.6. Payload Powiadomienie o możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_6:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.6. Payload Powiadomienie o możliwości aktualizacji danych w charakterystyce PP                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationValidationResultPayload" type="unk_2_2_1_6:MeteringPointModificationValidationResultPayload"/>
    <xs:complexType name="MeteringPointModificationValidationResultPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_6:plName>2.2.1.6. Payload Powiadomienie o możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_2_2_1_6:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Pozostałe elementy komunikatu</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-320</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_6:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Dane PP - ogólne</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-300</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_2_1_6:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_6:plName>Pozostałe elementy komunikatu</unk_2_2_1_6:plName>
                <unk_2_2_1_6:code>PL-320</unk_2_2_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>ID_instancji_procesu_referencyjnego</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-002</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Status możliwości aktualizacji -->
            <xs:element name="ModificationStatus" type="bdt:ModificationStatusType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Status możliwości aktualizacji</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-159</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Odpowiedź właściwego Operatora w zakresie możliwości aktualizacji parametrów charakterystyki PP.</xs:documentation>
                    <xs:documentation xml:lang="en">Response of the relevant Operator regarding the possibility of updating the parameters of the MP characteristics.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data i czas zmiany parametrów charakterystyki -->
            <xs:element name="ModificationDateTime" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Data i czas zmiany parametrów charakterystyki</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-023</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Parametr określa faktycznie czas dokonania zmiany dot. atrybutu charakterystyki PP. 
Możliwe jest tylko wskazanie w ramach doby "n", zgłaszanego komunikatu.</xs:documentation>
                    <xs:documentation xml:lang="en">The parameter actually determines the time of making a change regarding the attribute of MP characteristics. 
It is only possible to indicate within the day "n", the reported message.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Planowana data realizacji zmiany przez Operatora -->
            <xs:element name="PlannedModificationDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Planowana data realizacji zmiany przez Operatora</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-174</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zadeklarowana przez Operatora data zmiany wpływającej na charakterystykę Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">The date declared by the Operator for the change affecting the characteristics of the Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna odmowy -->
            <xs:element name="RejectionReason" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Przyczyna odmowy</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-136</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Przyczyna odmowy realizacji zgłoszenia.</xs:documentation>
                    <xs:documentation xml:lang="en">The reason for the denial of the request.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Opis błędu -->
            <xs:element name="ErrorDescription" type="bdt:String2000_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Opis błędu</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-499</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Opis błędu w formacie swobodnym, jeśli został wskazany kod "inne", czyli CE999 co oznacza, że błąd skutkujący odrzuceniem komunikatu nie był skatalogowany.</xs:documentation>
                    <xs:documentation xml:lang="en">Description of the error in free format, if the code "other" was indicated, i.e. CE999 which means that the error resulting in the rejection of the message was not cataloged.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_6:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_6:plName>Dane PP - ogólne</unk_2_2_1_6:plName>
                <unk_2_2_1_6:code>PL-300</unk_2_2_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_6:plName>Kod PP</unk_2_2_1_6:plName>
                        <unk_2_2_1_6:code>PL-001</unk_2_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>