    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 9.1.1.6. Powiadomienie o udostępnieniu żądania do rozpatrzenia                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="GenericInformationRealisationNotification" type="unk_9_1_1_6:GenericInformationRealisationNotification"/>
    <xs:complexType name="GenericInformationRealisationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_6:plName>9.1.1.6. Powiadomienie o udostępnieniu żądania do rozpatrzenia</unk_9_1_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>Nagłówek</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-700</unk_9_1_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>Kontekst</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-715</unk_9_1_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 9.1.1.6. Payload Powiadomienie o udostępnieniu żądania do rozpatrzenia -->
            <xs:element name="Payload" type="unk_9_1_1_6:GenericInformationRealisationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>9.1.1.6. Payload Powiadomienie o udostępnieniu żądania do rozpatrzenia</unk_9_1_1_6:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 9.1.1.6. Payload Powiadomienie o udostępnieniu żądania do rozpatrzenia                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="GenericInformationRealisationNotificationPayload" type="unk_9_1_1_6:GenericInformationRealisationNotificationPayload"/>
    <xs:complexType name="GenericInformationRealisationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_6:plName>9.1.1.6. Payload Powiadomienie o udostępnieniu żądania do rozpatrzenia</unk_9_1_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_9_1_1_6:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>Pozostałe elementy komunikatu</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-320</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_9_1_1_6:MeteringPointData_Operators" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>Dane PP - podmioty obsługujące PP</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-303</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_9_1_1_6:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_6:plName>Pozostałe elementy komunikatu</unk_9_1_1_6:plName>
                <unk_9_1_1_6:code>PL-320</unk_9_1_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_instancji_procesu_referencyjnego</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-002</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_9_1_1_6:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_6:plName>Dane PP - podmioty obsługujące PP</unk_9_1_1_6:plName>
                <unk_9_1_1_6:code>PL-303</unk_9_1_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_OIRE -->
            <xs:element name="OireIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_OIRE</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-141</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący operatora informacji rynku energii - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the energy market information operator - according to EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_Operator -->
            <xs:element name="OperatorIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_Operator</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-017</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Operatora, który utworzył oraz administruje PP. Kod identyfikacyjny zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Identification code of the Operator who created and administers the MP. Identification code in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_SE</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-019</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_POB -->
            <xs:element name="BalanceResponsiblePartyIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_POB</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-021</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący podmiot odpowiedzialny za bilansowanie handlowe - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the balance responsible party - in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_biznesowa_rola_adresata -->
            <xs:element name="RecipientBusinessRoleIdentifier" type="bdt:SenderRoleType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_6:plName>ID_biznesowa_rola_adresata</unk_9_1_1_6:plName>
                        <unk_9_1_1_6:code>PL-723</unk_9_1_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Rola pełniona przez adresata, zgodna z Harmonised Electricity Market Role Model.</xs:documentation>
                    <xs:documentation xml:lang="en">The role performed by the recipient, according to the Harmonised Electricity Market Role Model.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>