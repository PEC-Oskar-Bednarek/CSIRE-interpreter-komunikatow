    <xs:element name="BusinessData_SupplyAgreement" type="unk_1_1_1_1:BusinessData_SupplyAgreement"/>
    <xs:complexType name="BusinessData_SupplyAgreement">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_1_1_1:plName>Parametry handlowe - umowa sprzedaży</unk_1_1_1_1:plName>
                <unk_1_1_1_1:code>PL-318</unk_1_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 6.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
