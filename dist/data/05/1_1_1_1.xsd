                    <xs:appinfo>
                        <unk_1_1_1_1:plName>Dane Użytkownika KSE - identyfikacyjne</unk_1_1_1_1:plName>
                        <unk_1_1_1_1:code>PL-312</unk_1_1_1_1:code>
