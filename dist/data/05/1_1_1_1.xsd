    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - korespondencyjne                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_MailingAddress" type="unk_1_1_1_1:KseUserData_MailingAddress"/>
    <xs:complexType name="KseUserData_MailingAddress">
        <xs:annotation>
            <xs:appinfo>
                <unk_1_1_1_1:plName>Dane Użytkownika KSE - korespondencyjne</unk_1_1_1_1:plName>
                <unk_1_1_1_1:code>PL-314</unk_1_1_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Nazwa adresata -->
            <xs:element name="RecipientName" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_1_1_1_1:plName>Nazwa adresata</unk_1_1_1_1:plName>
                        <unk_1_1_1_1:code>PL-054</unk_1_1_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa adresata dla adresu do korespondencji</xs:documentation>
