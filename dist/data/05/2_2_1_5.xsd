    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.5. Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationValidationRequest" type="unk_2_2_1_5:MeteringPointModificationValidationRequest"/>
    <xs:complexType name="MeteringPointModificationValidationRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>2.2.1.5. Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_5:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Nagłówek</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-700</unk_2_2_1_5:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kontekst</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-715</unk_2_2_1_5:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.2.1.5. Payload Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP -->
            <xs:element name="Payload" type="unk_2_2_1_5:MeteringPointModificationValidationRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>2.2.1.5. Payload Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_5:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.5. Payload Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP                                                     ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationValidationRequestPayload" type="unk_2_2_1_5:MeteringPointModificationValidationRequestPayload"/>
    <xs:complexType name="MeteringPointModificationValidationRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>2.2.1.5. Payload Żądanie weryfikacji możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_5:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_5:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Dane PP - ogólne</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-300</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_2_2_1_5:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Pozostałe elementy komunikatu</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-320</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kategoria zgłoszenia -->
            <xs:element name="RequestCategory" type="unk_2_2_1_5:RequestCategory" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kategoria zgłoszenia</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-329</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_5:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>Dane PP - ogólne</unk_2_2_1_5:plName>
                <unk_2_2_1_5:code>PL-300</unk_2_2_1_5:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kod PP</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-001</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_2_1_5:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>Pozostałe elementy komunikatu</unk_2_2_1_5:plName>
                <unk_2_2_1_5:code>PL-320</unk_2_2_1_5:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Wnioskowana data zmiany parametrów charakterystyki -->
            <xs:element name="RequestedMpCharacteristicsChangeDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Wnioskowana data zmiany parametrów charakterystyki</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-150</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wnioskowana data zmiany parametrów charakterystyki PP, dotyczy doby dla której użytkownik CSIRE wnioskuje o zmianę parametrów w PP. 
Data ograniczona jedynie "wprzód".</xs:documentation>
                    <xs:documentation xml:lang="en">Requested date of change of MP characteristic parameters, refers to the day for which the CSIRE user requests a change of parameters in the MP. 
Date limited only by ''forward''.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>ID_instancji_procesu_referencyjnego</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-002</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Kategoria zgłoszenia                                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RequestCategory" type="unk_2_2_1_5:RequestCategory"/>
    <xs:complexType name="RequestCategory">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>Kategoria zgłoszenia</unk_2_2_1_5:plName>
                <unk_2_2_1_5:code>PL-329</unk_2_2_1_5:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kategoria aktualizacji charakterystyki PP -->
            <xs:element name="MpCharacteristicsUpdateType" type="bdt:MpCharacteristicsUpdateType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kategoria aktualizacji charakterystyki PP</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-162</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa typ zmiany parametrów charakterystyki PP.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines the type of change of MP characteristic parameters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - adresowe -->
            <xs:element name="MeteringPointData_Address" type="unk_2_2_1_5:MeteringPointData_Address" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Dane PP - adresowe</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-301</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - ogólne -->
            <xs:element name="TechnicalData_Basic" type="unk_2_2_1_5:TechnicalData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Parametry techniczne - ogólne</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-304</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - ogólne -->
            <xs:element name="BusinessData_Basic" type="unk_2_2_1_5:BusinessData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Parametry handlowe - ogólne</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-316</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - warunki świadczenia usług -->
            <xs:element name="BusinessData_TermsOfService" type="unk_2_2_1_5:BusinessData_TermsOfService" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Parametry handlowe - warunki świadczenia usług</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-321</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - podstawowe -->
            <xs:element name="KseUserData_Primary" type="unk_2_2_1_5:KseUserData_Primary" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Dane Użytkownika KSE - podstawowe</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-311</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.5.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Identyfikacja podmiotu Użytkownika KSE -->
            <xs:element name="KseUserPartyIdentification" type="unk_2_2_1_5:KseUserPartyIdentification" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Identyfikacja podmiotu Użytkownika KSE</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-478</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.6.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - adresowe -->
            <xs:element name="KseUserData_Address" type="unk_2_2_1_5:KseUserData_Address" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Dane Użytkownika KSE - adresowe</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-313</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.7.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - korespondencyjne -->
            <xs:element name="KseUserData_MailingAddress" type="unk_2_2_1_5:KseUserData_MailingAddress" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Dane Użytkownika KSE - korespondencyjne</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-314</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.8.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - adresowe                                                                                                                           ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Address" type="unk_2_2_1_5:MeteringPointData_Address"/>
    <xs:complexType name="MeteringPointData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_5:plName>Dane PP - adresowe</unk_2_2_1_5:plName>
                <unk_2_2_1_5:code>PL-301</unk_2_2_1_5:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kraj</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-003</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Miejscowość</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-004</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości (właściwa dla Punktu pomiarowego).</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the city (specific to the Metering Point).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Czy zastosowano podział na ulice?</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-558</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu PP w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this MP address</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Czy ulica zgodna z TERYT?</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-584</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:PostalCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Kod pocztowy</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-005</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Ulica</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-006</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Nr budynku</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-007</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu / mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Nr lokalu / mieszkania</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-008</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Nr działki</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-009</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>TERYT</unk_2_2_1_5:plName>
                        <unk_2_2_1_5:code>PL-010</unk_2_2_1_5:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szerokość geograficzna -->
            <xs:element name="Latitude" type="bdt:LatitudeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_5:plName>Szerokość geograficzna</unk_2_2_1_5:plName>
