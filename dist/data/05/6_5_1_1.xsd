<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_5_1_1="urn:pl:oire:unk_6_5_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_5_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 18.09.2026                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.5.1.1. Powiadomienie o zakończeniu Umowy profesjonalnej                                                                                    ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ProfessionalAgreementTerminationNotification" type="unk_6_5_1_1:ProfessionalAgreementTerminationNotification"/>
    <xs:complexType name="ProfessionalAgreementTerminationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_1:plName>6.5.1.1. Powiadomienie o zakończeniu Umowy profesjonalnej</unk_6_5_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>Nagłówek</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-700</unk_6_5_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>Kontekst</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-715</unk_6_5_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.5.1.1. Payload Powiadomienie o zakończeniu Umowy profesjonalnej -->
            <xs:element name="Payload" type="unk_6_5_1_1:ProfessionalAgreementTerminationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>6.5.1.1. Payload Powiadomienie o zakończeniu Umowy profesjonalnej</unk_6_5_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.5.1.1. Payload Powiadomienie o zakończeniu Umowy profesjonalnej                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ProfessionalAgreementTerminationNotificationPayload" type="unk_6_5_1_1:ProfessionalAgreementTerminationNotificationPayload"/>
    <xs:complexType name="ProfessionalAgreementTerminationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_1:plName>6.5.1.1. Payload Powiadomienie o zakończeniu Umowy profesjonalnej</unk_6_5_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_6_5_1_1:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>Informacje podstawowe</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-325</unk_6_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_6_5_1_1:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_1:plName>Informacje podstawowe</unk_6_5_1_1:plName>
                <unk_6_5_1_1:code>PL-325</unk_6_5_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ zgłaszanej umowy -->
            <xs:element name="ContractType" type="bdt:ContractType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>Typ zgłaszanej umowy</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-237</unk_6_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu umowy pomiędzy Użytkownikami profesjonalnymi dotyczące dostępu do sieci elektroenergetycznej. Na bazie zgłoszonych możliwych relacji OIRE weryfikuje zgłoszenia umów dot. Sprzedaży lub dot. bilansowania handlowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of agreement between Professional Users regarding access to the power grid. On the basis of the reported possible relationships, OIRE verifies the notification of supply agreements or on commercial balancing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>ID_SE</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-019</unk_6_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_POB -->
            <xs:element name="BalanceResponsiblePartyIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>ID_POB</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-021</unk_6_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący podmiot odpowiedzialny za bilansowanie handlowe - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the balance responsible party - in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Zgłaszana data zakończenia umowy -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_1:plName>Zgłaszana data zakończenia umowy</unk_6_5_1_1:plName>
                        <unk_6_5_1_1:code>PL-244</unk_6_5_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wnioskowana data zakończenia umowy (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">Requested date of termination of the agreement (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>