    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.9. Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationNegativeOperatorValidationResult" type="unk_2_2_1_9:MeteringPointModificationNegativeOperatorValidationResult"/>
    <xs:complexType name="MeteringPointModificationNegativeOperatorValidationResult">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_9:plName>2.2.1.9. Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_9:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Nagłówek</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-700</unk_2_2_1_9:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Kontekst</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-715</unk_2_2_1_9:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.2.1.9. Payload Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP -->
            <xs:element name="Payload" type="unk_2_2_1_9:MeteringPointModificationNegativeOperatorValidationResultPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>2.2.1.9. Payload Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_9:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.2.1.9. Payload Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointModificationNegativeOperatorValidationResultPayload" type="unk_2_2_1_9:MeteringPointModificationNegativeOperatorValidationResultPayload"/>
    <xs:complexType name="MeteringPointModificationNegativeOperatorValidationResultPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_9:plName>2.2.1.9. Payload Powiadomienie od Operatora o braku możliwości aktualizacji danych w charakterystyce PP</unk_2_2_1_9:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_2_2_1_9:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Pozostałe elementy komunikatu</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-320</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_9:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Dane PP - ogólne</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-300</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_2_1_9:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_9:plName>Pozostałe elementy komunikatu</unk_2_2_1_9:plName>
                <unk_2_2_1_9:code>PL-320</unk_2_2_1_9:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>ID_instancji_procesu_referencyjnego</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-002</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Status możliwości aktualizacji -->
            <xs:element name="ModificationStatus" type="bdt:ModificationStatusType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Status możliwości aktualizacji</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-159</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Odpowiedź właściwego Operatora w zakresie możliwości aktualizacji parametrów charakterystyki PP.</xs:documentation>
                    <xs:documentation xml:lang="en">Response of the relevant Operator regarding the possibility of updating the parameters of the MP characteristics.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna odmowy -->
            <xs:element name="RejectionReason" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Przyczyna odmowy</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-136</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Przyczyna odmowy realizacji zgłoszenia.</xs:documentation>
                    <xs:documentation xml:lang="en">The reason for the denial of the request.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Opis błędu -->
            <xs:element name="ErrorDescription" type="bdt:String2000_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Opis błędu</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-499</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Opis błędu w formacie swobodnym, jeśli został wskazany kod "inne", czyli CE999 co oznacza, że błąd skutkujący odrzuceniem komunikatu nie był skatalogowany.</xs:documentation>
                    <xs:documentation xml:lang="en">Description of the error in free format, if the code "other" was indicated, i.e. CE999 which means that the error resulting in the rejection of the message was not cataloged.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_2_1_9:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_2_1_9:plName>Dane PP - ogólne</unk_2_2_1_9:plName>
                <unk_2_2_1_9:code>PL-300</unk_2_2_1_9:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_2_1_9:plName>Kod PP</unk_2_2_1_9:plName>
                        <unk_2_2_1_9:code>PL-001</unk_2_2_1_9:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>