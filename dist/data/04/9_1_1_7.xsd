<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_9_1_1_7="urn:pl:oire:unk_9_1_1_7:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_9_1_1_7:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 9.1.1.7. Powiadomienie o odpowiedzi na żądanie                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="GenericInformationResultNotification" type="unk_9_1_1_7:GenericInformationResultNotification"/>
    <xs:complexType name="GenericInformationResultNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_7:plName>9.1.1.7. Powiadomienie o odpowiedzi na żądanie</unk_9_1_1_7:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Nagłówek</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-700</unk_9_1_1_7:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Kontekst</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-715</unk_9_1_1_7:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 9.1.1.7. Payload Powiadomienie o odpowiedzi na żądanie -->
            <xs:element name="Payload" type="unk_9_1_1_7:GenericInformationResultNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>9.1.1.7. Payload Powiadomienie o odpowiedzi na żądanie</unk_9_1_1_7:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 9.1.1.7. Payload Powiadomienie o odpowiedzi na żądanie                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="GenericInformationResultNotificationPayload" type="unk_9_1_1_7:GenericInformationResultNotificationPayload"/>
    <xs:complexType name="GenericInformationResultNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_7:plName>9.1.1.7. Payload Powiadomienie o odpowiedzi na żądanie</unk_9_1_1_7:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_9_1_1_7:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Pozostałe elementy komunikatu</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-320</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_9_1_1_7:MeteringPointData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Dane PP - ogólne</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-300</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szczegóły komunikatu -->
            <xs:element name="MessageDetails" type="unk_9_1_1_7:MessageDetails" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Szczegóły komunikatu</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-324</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_9_1_1_7:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_7:plName>Pozostałe elementy komunikatu</unk_9_1_1_7:plName>
                <unk_9_1_1_7:code>PL-320</unk_9_1_1_7:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>ID_instancji_procesu_referencyjnego</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-002</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_9_1_1_7:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_7:plName>Dane PP - ogólne</unk_9_1_1_7:plName>
                <unk_9_1_1_7:code>PL-300</unk_9_1_1_7:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Kod PP</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-001</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Identyfikator obiektu</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-424</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Szczegóły komunikatu                                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MessageDetails" type="unk_9_1_1_7:MessageDetails"/>
    <xs:complexType name="MessageDetails">
        <xs:annotation>
            <xs:appinfo>
                <unk_9_1_1_7:plName>Szczegóły komunikatu</unk_9_1_1_7:plName>
                <unk_9_1_1_7:code>PL-324</unk_9_1_1_7:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Odpowiedź na komunikat -->
            <xs:element name="ResponseCode" type="bdt:ComplaintResponseCode_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Odpowiedź na komunikat</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-265</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa wynik rozpatrzenia komunikatu.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines the result of the consideration of the message.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Uzasadnienie odpowiedzi -->
            <xs:element name="ResponseJustification" type="bdt:String1000_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_9_1_1_7:plName>Uzasadnienie odpowiedzi</unk_9_1_1_7:plName>
                        <unk_9_1_1_7:code>PL-266</unk_9_1_1_7:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Opis słowny odpowiedzi na komunikat - maksymalnie 1000 znaków.</xs:documentation>
                    <xs:documentation xml:lang="en">Verbal description of the response to the message - maximum 1000 characters.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>