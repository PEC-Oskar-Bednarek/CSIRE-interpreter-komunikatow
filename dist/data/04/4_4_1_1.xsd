<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_4_4_1_1="urn:pl:oire:unk_4_4_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_4_4_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.4.1.1. Żądanie zestawu PP                                                                                                                  ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointSetQuery" type="unk_4_4_1_1:MeteringPointSetQuery"/>
    <xs:complexType name="MeteringPointSetQuery">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_4_1_1:plName>4.4.1.1. Żądanie zestawu PP</unk_4_4_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Nagłówek</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-700</unk_4_4_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Kontekst</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-715</unk_4_4_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 4.4.1.1. Payload Żądanie zestawu PP -->
            <xs:element name="Payload" type="unk_4_4_1_1:MeteringPointSetQueryPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>4.4.1.1. Payload Żądanie zestawu PP</unk_4_4_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.4.1.1. Payload Żądanie zestawu PP                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointSetQueryPayload" type="unk_4_4_1_1:MeteringPointSetQueryPayload"/>
    <xs:complexType name="MeteringPointSetQueryPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_4_1_1:plName>4.4.1.1. Payload Żądanie zestawu PP</unk_4_4_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_4_4_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Pozostałe elementy komunikatu</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-320</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_4_4_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_4_1_1:plName>Pozostałe elementy komunikatu</unk_4_4_1_1:plName>
                <unk_4_4_1_1:code>PL-320</unk_4_4_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ zestawu PP -->
            <xs:element name="MeteringPointSetType" type="bdt:MeteringPointSetType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Typ zestawu PP</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-229</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy zapytanie o zestaw PP ma dotyczyć wszystkich PP lub ich zakres ma być zawężony zgodnie z proponowanym zakresem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determining whether the request for a set of MPs is to apply to all MPs or its scope is to be narrowed according to the proposed scope.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wnioskowana data zestawu PP -->
            <xs:element name="RequestDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Wnioskowana data zestawu PP</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-556</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dzień, dla którego ma być utworzony zestaw PP. Wskazana data nie może być wcześniejsza niż dzień uruchomienia CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The day for which the MP set is to be created. The indicated date cannot be earlier than the day of CSIRE start-up.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_4_4_1_1:MeteringPointData_Operators" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>Dane PP - podmioty obsługujące PP</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-303</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_4_4_1_1:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_4_1_1:plName>Dane PP - podmioty obsługujące PP</unk_4_4_1_1:plName>
                <unk_4_4_1_1:code>PL-303</unk_4_4_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_Operator -->
            <xs:element name="OperatorIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>ID_Operator</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-017</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Operatora, który utworzył oraz administruje PP. Kod identyfikacyjny zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Identification code of the Operator who created and administers the MP. Identification code in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>ID_SE</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-019</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_POB -->
            <xs:element name="BalanceResponsiblePartyIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_4_1_1:plName>ID_POB</unk_4_4_1_1:plName>
                        <unk_4_4_1_1:code>PL-021</unk_4_4_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący podmiot odpowiedzialny za bilansowanie handlowe - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the balance responsible party - in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>