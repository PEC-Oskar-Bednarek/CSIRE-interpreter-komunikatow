<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_5_1_4="urn:pl:oire:unk_6_5_1_4:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_5_1_4:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.5.1.4. Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ProfessionalAgreementTerminationPartyNotification" type="unk_6_5_1_4:ProfessionalAgreementTerminationPartyNotification"/>
    <xs:complexType name="ProfessionalAgreementTerminationPartyNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_4:plName>6.5.1.4. Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej</unk_6_5_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Nagłówek</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-700</unk_6_5_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Kontekst</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-715</unk_6_5_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.5.1.4. Payload Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej -->
            <xs:element name="Payload" type="unk_6_5_1_4:ProfessionalAgreementTerminationPartyNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>6.5.1.4. Payload Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej</unk_6_5_1_4:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.5.1.4. Payload Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ProfessionalAgreementTerminationPartyNotificationPayload" type="unk_6_5_1_4:ProfessionalAgreementTerminationPartyNotificationPayload"/>
    <xs:complexType name="ProfessionalAgreementTerminationPartyNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_4:plName>6.5.1.4. Payload Powiadomienie strony umowy o zakończeniu Umowy profesjonalnej</unk_6_5_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_6_5_1_4:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Pozostałe elementy komunikatu</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-320</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_6_5_1_4:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Informacje podstawowe</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-325</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_6_5_1_4:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_4:plName>Pozostałe elementy komunikatu</unk_6_5_1_4:plName>
                <unk_6_5_1_4:code>PL-320</unk_6_5_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>ID_instancji_procesu_referencyjnego</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-002</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_6_5_1_4:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_5_1_4:plName>Informacje podstawowe</unk_6_5_1_4:plName>
                <unk_6_5_1_4:code>PL-325</unk_6_5_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ zgłaszanej umowy -->
            <xs:element name="ContractType" type="bdt:ContractType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Typ zgłaszanej umowy</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-237</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu umowy pomiędzy Użytkownikami profesjonalnymi dotyczące dostępu do sieci elektroenergetycznej. Na bazie zgłoszonych możliwych relacji OIRE weryfikuje zgłoszenia umów dot. Sprzedaży lub dot. bilansowania handlowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of agreement between Professional Users regarding access to the power grid. On the basis of the reported possible relationships, OIRE verifies the notification of supply agreements or on commercial balancing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>ID_SE</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-019</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_POB -->
            <xs:element name="BalanceResponsiblePartyIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>ID_POB</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-021</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący podmiot odpowiedzialny za bilansowanie handlowe - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the balance responsible party - in accordance with the EIC.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_Operator -->
            <xs:element name="OperatorIdentifier" type="bdt:EicIdentifierType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>ID_Operator</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-017</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Operatora, który zgłosił zakończenie Umowy Profesjonalnej.</xs:documentation>
                    <xs:documentation xml:lang="en">Identification code of the Operator who reported the termination of the Professional Contract.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Zgłaszana data zakończenia umowy -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_5_1_4:plName>Zgłaszana data zakończenia umowy</unk_6_5_1_4:plName>
                        <unk_6_5_1_4:code>PL-244</unk_6_5_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wnioskowana data zakończenia umowy (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">Requested date of termination of the agreement (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>