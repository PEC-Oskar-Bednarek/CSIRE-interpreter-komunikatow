<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_10_2_1_1="urn:pl:oire:unk_10_2_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_10_2_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.2.1.1. Powiadomienie o zmianie danych obiektu                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityDataModificationNotification" type="unk_10_2_1_1:FacilityDataModificationNotification"/>
    <xs:complexType name="FacilityDataModificationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>10.2.1.1. Powiadomienie o zmianie danych obiektu</unk_10_2_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Nagłówek</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-700</unk_10_2_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Kontekst</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-715</unk_10_2_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 10.2.1.1. Payload Powiadomienie o zmianie danych obiektu -->
            <xs:element name="Payload" type="unk_10_2_1_1:FacilityDataModificationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>10.2.1.1. Payload Powiadomienie o zmianie danych obiektu</unk_10_2_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.2.1.1. Payload Powiadomienie o zmianie danych obiektu                                                                                     ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityDataModificationNotificationPayload" type="unk_10_2_1_1:FacilityDataModificationNotificationPayload"/>
    <xs:complexType name="FacilityDataModificationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>10.2.1.1. Payload Powiadomienie o zmianie danych obiektu</unk_10_2_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_10_2_1_1:FacilityData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Dane obiektu - ogólne</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-425</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_10_2_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Pozostałe elementy komunikatu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-320</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <xs:choice>
                <!-- Zmiana atrybutów obiektu -->
                <xs:element name="FacilityAttributeModification" type="unk_10_2_1_1:FacilityAttributeModification" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Zmiana atrybutów obiektu</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-476</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Zmiana udziałów wspólnoty prosumenckiej -->
                <xs:element name="ProsumerCommunityRenewableEnergySourcesInformation" type="unk_10_2_1_1:ProsumerCommunityRenewableEnergySourcesInformation" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Zmiana udziałów wspólnoty prosumenckiej</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-555</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Dodanie PP do obiektu -->
                <xs:element name="FacilityMpAddition" type="unk_10_2_1_1:FacilityMpAddition" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Dodanie PP do obiektu</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-472</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Usunięcie PP z obiektu -->
                <xs:element name="FacilityMpRemoval" type="unk_10_2_1_1:FacilityMpRemoval" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Usunięcie PP z obiektu</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-477</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 6.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_10_2_1_1:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Dane obiektu - ogólne</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-425</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Identyfikator obiektu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-424</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_10_2_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Pozostałe elementy komunikatu</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-320</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ zmiany obiektu -->
            <xs:element name="FacilityChangeType" type="bdt:FacilityChangeType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Typ zmiany obiektu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-470</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, jakiego rodzaju zmiany obiektu dotyczy komunikat.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of what type of change of facility the message concerns.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ obiektu -->
            <xs:element name="FacilityType" type="bdt:FacilityType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Typ obiektu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-423</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu obiektu, którego dotyczy zmiana atrybutów, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of facility affected by the attribute change, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wnioskowana data zmiany parametrów obiektu -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Wnioskowana data zmiany parametrów obiektu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-150</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wnioskowana data zmiany parametrów obiektu, dotyczy doby dla której użytkownik CSIRE wnioskuje o zmianę parametrów w PP. 
Data ograniczona jedynie "wprzód".</xs:documentation>
                    <xs:documentation xml:lang="en">Requested date of change of facility parameters, applies to the day for which the CSIRE user is requesting a change of parameters in the MP. 
Date limited only by ''forward''.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Zmiana atrybutów obiektu                                                                                                                     ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityAttributeModification" type="unk_10_2_1_1:FacilityAttributeModification"/>
    <xs:complexType name="FacilityAttributeModification">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Zmiana atrybutów obiektu</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-476</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane obiektu - ogólne (aktualizacja) -->
            <xs:element name="FacilityData_Basic_Update" type="unk_10_2_1_1:FacilityData_Basic_Update" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Dane obiektu - ogólne (aktualizacja)</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-425</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <xs:choice>
                <!-- Obiekt sumujący -->
                <xs:element name="AggregatingFacility" type="unk_10_2_1_1:AggregatingFacility" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Obiekt sumujący</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-453</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Wspólnota energetyczna -->
                <xs:element name="EnergyCommunity" type="unk_10_2_1_1:EnergyCommunity" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Wspólnota energetyczna</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-455</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Wspólnota prosumencka -->
                <xs:element name="ProsumerCommunity" type="unk_10_2_1_1:ProsumerCommunity" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Wspólnota prosumencka</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-464</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 3.4.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                
                <!-- Beneficjent systemu wsparcia -->
                <xs:element name="SupportSystemBeneficiary" type="unk_10_2_1_1:SupportSystemBeneficiary" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:appinfo>
                            <unk_10_2_1_1:plName>Beneficjent systemu wsparcia</unk_10_2_1_1:plName>
                            <unk_10_2_1_1:code>PL-549</unk_10_2_1_1:code>
                        </xs:appinfo>
                        <xs:documentation xml:lang="pl">Sekcja 3.5.</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne (aktualizacja)                                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic_Update" type="unk_10_2_1_1:FacilityData_Basic_Update"/>
    <xs:complexType name="FacilityData_Basic_Update">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Dane obiektu - ogólne (aktualizacja)</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-425</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Nazwa obiektu -->
            <xs:element name="FacilityName" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Nazwa obiektu</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-426</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa obiektu, o ile została nadana.</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the facility, if assigned.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy posiada szczególne warunki świadczenia usług? -->
            <xs:element name="HasSpecificServiceConditions" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Czy posiada szczególne warunki świadczenia usług?</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-118</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla obiektu pomiarowego zachodzą nietypowe warunki świadczenia usług.
Dotyczy przypadków, gdy występuje różnica pomiędzy warunkami świadczenia usług dla PP wchodzących w skład obiektu oraz całym obiektem pomiarowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of whether abnormal service conditions exist for the metering facility.
Applies to cases where there is a difference between the conditions of service for the MPs included in the facility and the entire metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szczególne warunki świadczenia usług -->
            <xs:element name="SpecificTermsOfService" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Szczególne warunki świadczenia usług</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-370</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie szczegółowych warunków świadczenia usług. Dotyczy przypadków, gdy występuje różnica pomiędzy warunkami świadczenia usług dla PP wchodzących w skład obiektu oraz całym obiektem pomiarowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the detailed conditions for the provision of services. Applies to cases where there is a difference between the terms of service for MPs included in the facility and the entire metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Obiekt sumujący                                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AggregatingFacility" type="unk_10_2_1_1:AggregatingFacility"/>
    <xs:complexType name="AggregatingFacility">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Obiekt sumujący</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-453</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ obiektu sumującego -->
            <xs:element name="AggregatingFacilityType" type="bdt:AggregatingFacilityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Typ obiektu sumującego</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-454</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy sumator jest urządzeniem pomiarowym na sieci, czy sumowanie następuje w systemie bilingowym Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the aggregator is a metering device on the network, or whether the aggregation is done in the Operator's billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Rodzaj obiektu sumującego -->
            <xs:element name="AggregatingFacilityDetails" type="bdt:String100_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Rodzaj obiektu sumującego</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-437</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Doprecyzowanie, czego dotyczy rozliczanie z obiektem sumującym, zgodnie z zawartą umową z Użytkownikiem KSE.</xs:documentation>
                    <xs:documentation xml:lang="en">Clarification of what the billing to the aggregating facility is for, according to the agreement with the KSE User.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wspólnota energetyczna                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="EnergyCommunity" type="unk_10_2_1_1:EnergyCommunity"/>
    <xs:complexType name="EnergyCommunity">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_2_1_1:plName>Wspólnota energetyczna</unk_10_2_1_1:plName>
                <unk_10_2_1_1:code>PL-455</unk_10_2_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy zawarta UD? -->
            <xs:element name="HasDistributionAgreement" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Czy zawarta UD?</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-514</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy wspólnota energetyczna zawarła umowę o świadczenie usług dystrybucji energii elektrycznej z OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the energy community has entered into an agreement for the provision of electricity distribution services with the DSO.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ strony umowy -->
            <xs:element name="AgreementPartyType" type="bdt:KseUserType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_2_1_1:plName>Typ strony umowy</unk_10_2_1_1:plName>
                        <unk_10_2_1_1:code>PL-456</unk_10_2_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu strony umowy zawartej przez wspólnotę energetyczną.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of party to the agreement entered into by the energy community.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
