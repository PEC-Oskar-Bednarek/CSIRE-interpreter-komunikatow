<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_2_8_1_10="urn:pl:oire:unk_2_8_1_10:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_2_8_1_10:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.8.1.10. Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotification" type="unk_2_8_1_10:PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotification"/>
    <xs:complexType name="PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_8_1_10:plName>2.8.1.10. Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP</unk_2_8_1_10:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Nagłówek</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-700</unk_2_8_1_10:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Kontekst</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-715</unk_2_8_1_10:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.8.1.10. Payload Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP -->
            <xs:element name="Payload" type="unk_2_8_1_10:PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>2.8.1.10. Payload Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP</unk_2_8_1_10:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.8.1.10. Payload Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotificationPayload" type="unk_2_8_1_10:PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotificationPayload"/>
    <xs:complexType name="PlannedMeteringPointCharacteristicsDataMarketUserRemovalNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_8_1_10:plName>2.8.1.10. Payload Powiadomienie o planowanym wypisaniu Użytkownika profesjonalnego z charakterystyki PP</unk_2_8_1_10:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_8_1_10:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Dane PP - ogólne</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-300</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_2_8_1_10:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Pozostałe elementy komunikatu</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-320</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_8_1_10:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_8_1_10:plName>Dane PP - ogólne</unk_2_8_1_10:plName>
                <unk_2_8_1_10:code>PL-300</unk_2_8_1_10:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Kod PP</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-001</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_8_1_10:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_8_1_10:plName>Pozostałe elementy komunikatu</unk_2_8_1_10:plName>
                <unk_2_8_1_10:code>PL-320</unk_2_8_1_10:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>ID_instancji_procesu_referencyjnego</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-002</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Planowana data wypisania parametrów umowy z charakterystyki PP -->
            <xs:element name="PlannedAgreementRemovalDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Planowana data wypisania parametrów umowy z charakterystyki PP</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-155</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Ostatni dzień przypisania umowy do charakterystyki PP (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">The last day of assignment of the agreement to the MP characteristics (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data wykreślenia z charakterystyki -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Data wykreślenia z charakterystyki</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-512</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data, od której dany Użytkownik profesjonalny nie jest już przypisany do charakterystyki PP.</xs:documentation>
                    <xs:documentation xml:lang="en">The date from which a given Professional User is no longer assigned to a MP characteristic.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacja o demontażu układu pom-rozl. -->
            <xs:element name="InformationOnMeterRemoval" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_8_1_10:plName>Informacja o demontażu układu pom-rozl.</unk_2_8_1_10:plName>
                        <unk_2_8_1_10:code>PL-269</unk_2_8_1_10:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego PPE Użytkownik KSE na umowie kompleksowej wnosi o demontaż licznika.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether, for a given MP, the KSE User on a comprehensive agreement requests the removal of the meter.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>