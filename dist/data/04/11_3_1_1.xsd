<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_11_3_1_1="urn:pl:oire:unk_11_3_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_11_3_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 11.3.1.1. Wysłanie historycznych Informacji rozliczeniowych GUD-k                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotification" type="unk_11_3_1_1:HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotification"/>
    <xs:complexType name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>11.3.1.1. Wysłanie historycznych Informacji rozliczeniowych GUD-k</unk_11_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Nagłówek</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-700</unk_11_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Kontekst</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-715</unk_11_3_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 11.3.1.1. Payload Wysłanie historycznych Informacji rozliczeniowych GUD-k -->
            <xs:element name="Payload" type="unk_11_3_1_1:HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>11.3.1.1. Payload Wysłanie historycznych Informacji rozliczeniowych GUD-k</unk_11_3_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 11.3.1.1. Payload Wysłanie historycznych Informacji rozliczeniowych GUD-k                                                                    ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotificationPayload" type="unk_11_3_1_1:HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotificationPayload"/>
    <xs:complexType name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementDataNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>11.3.1.1. Payload Wysłanie historycznych Informacji rozliczeniowych GUD-k</unk_11_3_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_11_3_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Pozostałe elementy komunikatu</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-320</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Rekord operacji masowej -->
            <xs:element name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementData" type="unk_11_3_1_1:HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementData" minOccurs="1" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Rekord operacji masowej</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-711</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_11_3_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Pozostałe elementy komunikatu</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-320</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>ID_SE</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-019</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Rekord operacji masowej                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementData" type="unk_11_3_1_1:HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementData"/>
    <xs:complexType name="HistoricalCorrectionForGeneralDistributionComplexAgreementSettlementData">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Rekord operacji masowej</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-711</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator transakcji -->
            <xs:element name="ReferenceTransactionId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Identyfikator transakcji</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-710</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator rekordu nadawany przez Operatora, używany do korelacji rekordu żądania do rekordu wyniku</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier assigned by Operator, used for batch record identification</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_11_3_1_1:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Dane PP - ogólne</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-300</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_11_3_1_1:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Informacje podstawowe</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-325</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane pomiarowe -->
            <xs:element name="MeasurementData" type="unk_11_3_1_1:MeasurementData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Dane pomiarowe</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-349</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane rozliczeniowe -->
            <xs:element name="BillingData" type="unk_11_3_1_1:BillingData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Dane rozliczeniowe</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-332</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Podsumowanie dokumentu rozliczeniowego -->
            <xs:element name="BillingDocumentSummary" type="unk_11_3_1_1:BillingDocumentSummary" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Podsumowanie dokumentu rozliczeniowego</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-340</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.5.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_11_3_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Dane PP - ogólne</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-300</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Kod PP</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-001</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_11_3_1_1:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Informacje podstawowe</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-325</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data i czas dokonania rozliczenia -->
            <xs:element name="BillingDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data i czas dokonania rozliczenia</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-178</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data i czas dokonania rozliczenia.</xs:documentation>
                    <xs:documentation xml:lang="en">Date and time of billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_rozliczenia -->
            <xs:element name="BillingIdentifier" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>ID_rozliczenia</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-226</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy identyfikator rozliczenia danego PPE, nadawany przez OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique identifier of the billing of a given PPE, assigned by the DSO.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_rozliczenia_wzajemnego_OSD-SE -->
            <xs:element name="DsoSupplierSettlementIdentifier" type="bdt:String50_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>ID_rozliczenia_wzajemnego_OSD-SE</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-224</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator dokumentu (faktury zbiorczej/zagregowanej lub noty uznaniowej), wystawianej przez Operatora dla SE z tytułu usług dystrybucyjnych świadczonych przez Operatora na rzecz Użytkowników z którymi SE ma zawarte umowy kompleksowe, w którym uwzględnione jest dane rozliczenie</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier of the document (summary/aggregate invoice or credit note), issued by the Operator to the Energy Supplier for distribution services provided by the Operator to Users with whom the ES has concluded comprehensive agreements, in which the billing in question is included</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ danych rozliczeniowych -->
            <xs:element name="BillingDataSource" type="bdt:BillingDataSourceType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Typ danych rozliczeniowych</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-207</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie pochodzenia danych rozliczeniowych, wykorzystywanych do rozliczenia opłat dystrybucyjnych w PPE.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the origin of billing data, used for billing distribution charges in the MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane profilowe -->
            <xs:element name="IsProfileDataUsed" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Dane profilowe</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-459</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do rozliczenia wykorzystywane są sumaryczne dane pochodzące z dobowych profili zużycia.</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether aggregate data from daily consumption profiles are used for billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane z rejestrów OBIS -->
            <xs:element name="IsRegisterDataUsed" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Dane z rejestrów OBIS</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-460</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do rozliczenia wykorzystywane są wskazania rejestrów zgodnych z OBIS.</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether OBIS-compliant register measurements are used for billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Zużycie energii w roku bazowym -->
            <xs:element name="BaselineYearEnergyConsumption" type="bdt:BaselineYearEnergyConsumptionType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Zużycie energii w roku bazowym</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-148</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość zużycia w strefie nocnej w roku bazowym dla grupy taryfowej G12as, wyrażona w [kWh].</xs:documentation>
                    <xs:documentation xml:lang="en">The value of consumption in the night zone in the base year for tariff group G12as, expressed in [kWh].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Okres rozliczeniowy -->
            <xs:element name="BillingPeriod" type="bdt:BillingPeriod_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Okres rozliczeniowy</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-275</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Okres rozliczeniowy usług dystrybucji - zgodny z okresem rozliczeniowym Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Billing period for distribution services - consistent with the Operator's billing period.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy PPE został zgrupowany -->
            <xs:element name="IsGrouped" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Czy PPE został zgrupowany</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-438</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy punkt poboru energii został zgrupowany z innymi punktami poboru energii w celu wyliczenia opłaty mocowej dla określonej grupy odbiorców końcowych (K1, K2, K3, K4).</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the power point was grouped with other power points for the purpose of calculating the power charge for a specific group of end users (K1, K2, K3, K4).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Grupowanie PPE OM -->
            <xs:element name="EnergyConsumptionMeteringPointGroup" type="unk_11_3_1_1:EnergyConsumptionMeteringPointGroup" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Grupowanie PPE OM</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-439</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Grupowanie PPE OM                                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="EnergyConsumptionMeteringPointGroup" type="unk_11_3_1_1:EnergyConsumptionMeteringPointGroup"/>
    <xs:complexType name="EnergyConsumptionMeteringPointGroup">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Grupowanie PPE OM</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-439</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Kod PP</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-440</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący punkt pomiarowy, który został zgrupowany w celu wyznaczenia opłaty mocowej dla określonej grupy odbiorców końcowych (K1, K2, K3, K4). Lista kodów powinna uwzględniać także kod PPE, którego dotyczy przekazanie IRGUD-k.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the metering point that has been grouped to determine the power charge for a specific group of end users (K1, K2, K3, K4). The list of codes should also include the code of the PPE to which the IRGUD-k transfer applies.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane pomiarowe                                                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeasurementData" type="unk_11_3_1_1:MeasurementData"/>
    <xs:complexType name="MeasurementData">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Dane pomiarowe</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-349</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Licznik -->
            <xs:element name="Meter" type="unk_11_3_1_1:Meter" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Licznik</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-348</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ryczałt -->
            <xs:element name="FlatRate" type="unk_11_3_1_1:FlatRate" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Ryczałt</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-327</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Licznik                                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Meter" type="unk_11_3_1_1:Meter"/>
    <xs:complexType name="Meter">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Licznik</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-348</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Nr licznika -->
            <xs:element name="MeterNumber" type="bdt:MeterNumberType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Nr licznika</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-097</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer seryjny podstawowego licznika energii czynnej.</xs:documentation>
                    <xs:documentation xml:lang="en">Serial number of the primary active energy meter.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Rejestr pomiarowy -->
            <xs:element name="MeteringRegister" type="unk_11_3_1_1:MeteringRegister" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Rejestr pomiarowy</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-212</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Podsumowanie profilowych danych -->
            <xs:element name="MeasurementDataSummary" type="unk_11_3_1_1:MeasurementDataSummary" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Podsumowanie profilowych danych</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-458</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Rejestr pomiarowy                                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringRegister" type="unk_11_3_1_1:MeteringRegister"/>
    <xs:complexType name="MeteringRegister">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Rejestr pomiarowy</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-212</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ rejestru -->
            <xs:element name="RegisterType" type="bdt:MeterRegistryType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Typ rejestru</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-088</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodnie z opisem protokołu IEC62056, atrybut wskazuje rejestr pomiarowy licznika energii elektrycznej, którego dotyczy przekazywanie wskazań pomiarowych.</xs:documentation>
                    <xs:documentation xml:lang="en">According to the description of the IEC62056 protocol, the attribute indicates the measurement register of the electricity meter to which the transmission of measurement readings applies.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wskazania energii -->
            <xs:element name="EnergyMeasurement" type="unk_11_3_1_1:EnergyMeasurement" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wskazania energii</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-326</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wskazania mocy -->
            <xs:element name="PowerMeasurement" type="unk_11_3_1_1:PowerMeasurement" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wskazania mocy</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-331</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wskazania energii                                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="EnergyMeasurement" type="unk_11_3_1_1:EnergyMeasurement"/>
    <xs:complexType name="EnergyMeasurement">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Wskazania energii</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-326</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Pochodzenie bieżącego wskazania -->
            <xs:element name="MeasurementSource" type="bdt:MeasurementSourceType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Pochodzenie bieżącego wskazania</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-196</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod specyfikujący pochodzenie wskazania.</xs:documentation>
                    <xs:documentation xml:lang="en">Code specifying the origin of the measurement.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data i czas bieżącego wskazania -->
            <xs:element name="MeasurementDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data i czas bieżącego wskazania</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-198</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data i czas bieżącego wskazania dla wyznaczonych danych pomiarowych.</xs:documentation>
                    <xs:documentation xml:lang="en">Date and time of current measurement for designated metering data.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wskazanie bieżące rejestru -->
            <xs:element name="MeterRegisterValue" type="bdt:MeterRegistryValueType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wskazanie bieżące rejestru</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-184</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Bieżące wskazanie rejestru licznika z uwzględnieniem czterech miejsc po przecinku.</xs:documentation>
                    <xs:documentation xml:lang="en">Current meter register measurement with four decimal places.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Mnożna liczydła -->
            <xs:element name="MeterMultiplier" type="bdt:MultiplierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Mnożna liczydła</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-208</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Współczynnik wynikający z parametrów układu pomiarowo-rozliczeniowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Factor resulting from the parameters of the metering and billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Zdarzenia dla rejestru -->
            <xs:element name="MeterRegisterEventType" type="bdt:MeterRegistryEventType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Zdarzenia dla rejestru</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-187</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Powiadomienie o zdarzeniu dla rejestru licznika.</xs:documentation>
                    <xs:documentation xml:lang="en">Event notification for the meter register.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data i czas poprzedniego wskazania -->
            <xs:element name="PreviousMeasurementDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data i czas poprzedniego wskazania</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-194</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data i czas poprzedniego odczytu albo wyznaczenia danych pomiarowych.</xs:documentation>
                    <xs:documentation xml:lang="en">Date and time of previous reading or designated metering data.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wskazanie poprzednie rejestru -->
            <xs:element name="PreviousMeterRegisterValue" type="bdt:MeterRegistryValueType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wskazanie poprzednie rejestru</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-183</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Poprzednie wskazanie rejestru licznika z uwzględnieniem czterech miejsc po przecinku.</xs:documentation>
                    <xs:documentation xml:lang="en">Previous meter register measurement including four decimal places.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Podsumowanie wskazania -->
            <xs:element name="MeasurementInformation" type="unk_11_3_1_1:MeasurementInformation" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Podsumowanie wskazania</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-328</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Podsumowanie wskazania                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeasurementInformation" type="unk_11_3_1_1:MeasurementInformation"/>
    <xs:complexType name="MeasurementInformation">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Podsumowanie wskazania</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-328</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Wolumen -->
            <xs:element name="Volume" type="bdt:VolumeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wolumen</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-204</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Ilość energii dla rejestru, wynikająca z różnicy wskazań oraz mnożnej. Określana zgodnie z wybranym typem rejestru w [kWh], [kVarh], z dokładnością do czterech miejsc po przecinku.</xs:documentation>
                    <xs:documentation xml:lang="en">The amount of energy for the register, resulting from the difference in measurements and the multiplier. Determined according to the selected register type in [kWh], [kVarh], to four decimal places.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Straty -->
            <xs:element name="LossVolume" type="bdt:RealVolumeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Straty</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-202</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wielkość strat energii dla każdego rejestru z uwzględnieniem mnożnej liczydła. W przypadku wystąpienia korekty wolumenowej wielkosć strat wyliczana jest ze zużycia po odjęciu/dodaniu korekty.
Wartości ujemne pomniejszają ilość energii, dodatnie powiększają wolumen. Jeżeli straty nie są określone, należy przyjąć wartość "0".</xs:documentation>
                    <xs:documentation xml:lang="en">The volume of energy losses for each register taking into account the meter multiplier. If there is a volume adjustment, the volume of losses is calculated from the consumption after subtracting/adding the adjustment.
Negative values decrease the amount of energy, positive values increase the volume. If the losses are not specified, take the value of "0".</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Korekta wolumenu -->
            <xs:element name="CorrectedVolume" type="bdt:RealVolumeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Korekta wolumenu</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-201</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Korekta wolumenu energii dla poszczególnych rejestrów z uwzględnieniem mnożnej liczydła.
Wartości ujemne pomniejszają wolumen, dodatnie powiększają wolumen. W przypadku braku potrzeby doliczeń/odliczeń ilości energii należy wprowadzić wartość "0".</xs:documentation>
                    <xs:documentation xml:lang="en">Adjustment of the volume of energy for individual registers taking into account the meter multiplier.
Negative values decrease the volume, positive values increase the volume. If there is no need for energy volume additions/deductions, enter the value "0".</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna korekty wolumenu -->
            <xs:element name="VolumeCorrectionReason" type="bdt:VolumeCorrectionReasonType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Przyczyna korekty wolumenu</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-203</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie przyczyny korekty wolumenu dla rejestru pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the reason for volume correction for the metering register.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Sumaryczny wolumen -->
            <xs:element name="TotalVolume" type="bdt:VolumeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Sumaryczny wolumen</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-205</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sumaryczna ilość energii, wyznaczona jako suma wartości atrybutów: wolumen, straty i korekta wolumenu wielkość wolumenu. Określana zgodnie z wybranym typem rejestru w [kWh], [kVarh].</xs:documentation>
                    <xs:documentation xml:lang="en">The total amount of energy, determined as the sum of the values of the attributes: volume, losses and volume adjustment volume. Determined according to the selected register type in [kWh], [kVarh].</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wskazania mocy                                                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PowerMeasurement" type="unk_11_3_1_1:PowerMeasurement"/>
    <xs:complexType name="PowerMeasurement">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Wskazania mocy</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-331</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Moc pobrana maksymalna -->
            <xs:element name="MaxConsumedPower" type="bdt:PowerKiloWattsType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Moc pobrana maksymalna</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-282</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartości te stanowią podstawę do pobrania przez Operatora opłaty za przekroczenie mocy umownej. Wartość uwzględnia mnożną, straty, korekty.
Dla przekroczenia poboru mocy jako: 
1) sumy wartości należy podać maksymalne wartości poboru mocy (maksymalnie 10 dla każdego miesiąca), 
2) 10 krotności wartości, należy podać jedną wartość (dla całego okresu rozliczeniowego) przed mnożeniem przez 10.</xs:documentation>
                    <xs:documentation xml:lang="en">These values are the basis for the Operator to charge for exceeding the contracted capacity. The value takes into account multiplication, losses, adjustments.
For excess power consumption as: 
1) sums of values, the maximum values of power consumption should be given (maximum 10 for each month), 
2) 10 times the value, provide one value (for the entire billing period) before multiplying by 10.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data i czas poboru mocy -->
            <xs:element name="MaxConsumedPowerDateTime" type="xs:dateTime" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data i czas poboru mocy</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-283</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie daty i czasu wskazania poboru mocy.</xs:documentation>
                    <xs:documentation xml:lang="en">Specifying the date and time of measurement of power consumption.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Podsumowanie profilowych danych                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeasurementDataSummary" type="unk_11_3_1_1:MeasurementDataSummary"/>
    <xs:complexType name="MeasurementDataSummary">
        <xs:annotation>
            <xs:appinfo>
                <unk_11_3_1_1:plName>Podsumowanie profilowych danych</unk_11_3_1_1:plName>
                <unk_11_3_1_1:code>PL-458</unk_11_3_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.3.1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ rozliczanego produktu energetycznego -->
            <xs:element name="BillingProfileEnergyProductType" type="bdt:BillingProfileEnergyProductType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Typ rozliczanego produktu energetycznego</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-441</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie właściwego produktu energetycznego, zgodnie z listą. Wskazane produkty dotyczą profili rozliczeniowych.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the relevant energy product, according to the list. The indicated products refer to billing profiles.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data początku okresu -->
            <xs:element name="PeriodStartDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data początku okresu</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-179</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data początku przedziału czasowego, dla którego są przekazywane sumaryczne dane profilowe (od początku doby).</xs:documentation>
                    <xs:documentation xml:lang="en">Date of the beginning of the time interval for which aggregate profile data is provided (from the beginning of the day).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data końca okresu -->
            <xs:element name="PeriodEndDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Data końca okresu</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-180</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data końcowa przedziału czasowego, dla którego są przekazane sumaryczne dane profilowe (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">End date of the time interval for which aggregate profile data are provided (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wolumen -->
            <xs:element name="Volume" type="bdt:RealVolumeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_11_3_1_1:plName>Wolumen</unk_11_3_1_1:plName>
                        <unk_11_3_1_1:code>PL-185</unk_11_3_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sumaryczna wielkość pobranej lub wprowadzonej energii elektrycznej wynikająca z profili rozliczeniowych, wyrażona w [kWh]. Wartości dodatnie (+) oznaczają energię pobraną z sieci, wartości ujemne (-) oznaczają energię wprowadzoną do sieci.</xs:documentation>
                    <xs:documentation xml:lang="en">The summed volume of electricity withdrawn or injected resulting from billing profiles, expressed in [kWh]. Positive values (+) represent energy taken from the grid, negative values (-) represent energy injected into the grid.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
