    <xs:element name="DailyMeteringPointMeasurementsDataRequest" type="unk_7_1_1_1:DailyMeteringPointMeasurementsDataRequest"/>
    <xs:complexType name="DailyMeteringPointMeasurementsDataRequest">
        <xs:annotation>
            <xs:appinfo>
