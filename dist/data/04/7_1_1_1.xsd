    <!-- ====================================================================================================================================================== -->
    <!-- ==== 7.1.1.1. Payload Żądanie dobowego profilu zużycia                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="DailyMeteringPointMeasurementsDataRequestPayload" type="unk_7_1_1_1:DailyMeteringPointMeasurementsDataRequestPayload"/>
    <xs:complexType name="DailyMeteringPointMeasurementsDataRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_1_1_1:plName>7.1.1.1. Payload Żądanie dobowego profilu zużycia</unk_7_1_1_1:plName>
