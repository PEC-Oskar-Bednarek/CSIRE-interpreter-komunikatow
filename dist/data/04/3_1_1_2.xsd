<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_3_1_1_2="urn:pl:oire:unk_3_1_1_2:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_3_1_1_2:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 3.1.1.2. Powiadomienie o wykreśleniu z charakterystyki PP                                                                                    ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointCharacteristicsDataRemovalNotification" type="unk_3_1_1_2:MeteringPointCharacteristicsDataRemovalNotification"/>
    <xs:complexType name="MeteringPointCharacteristicsDataRemovalNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_3_1_1_2:plName>3.1.1.2. Powiadomienie o wykreśleniu z charakterystyki PP</unk_3_1_1_2:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Nagłówek</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-700</unk_3_1_1_2:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Kontekst</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-715</unk_3_1_1_2:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 3.1.1.2. Payload Powiadomienie o wykreśleniu z charakterystyki PP -->
            <xs:element name="Payload" type="unk_3_1_1_2:MeteringPointCharacteristicsDataRemovalNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>3.1.1.2. Payload Powiadomienie o wykreśleniu z charakterystyki PP</unk_3_1_1_2:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 3.1.1.2. Payload Powiadomienie o wykreśleniu z charakterystyki PP                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointCharacteristicsDataRemovalNotificationPayload" type="unk_3_1_1_2:MeteringPointCharacteristicsDataRemovalNotificationPayload"/>
    <xs:complexType name="MeteringPointCharacteristicsDataRemovalNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_3_1_1_2:plName>3.1.1.2. Payload Powiadomienie o wykreśleniu z charakterystyki PP</unk_3_1_1_2:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_3_1_1_2:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Dane PP - ogólne</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-300</unk_3_1_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_3_1_1_2:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Pozostałe elementy komunikatu</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-320</unk_3_1_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_3_1_1_2:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_3_1_1_2:plName>Dane PP - ogólne</unk_3_1_1_2:plName>
                <unk_3_1_1_2:code>PL-300</unk_3_1_1_2:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Kod PP</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-001</unk_3_1_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_3_1_1_2:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_3_1_1_2:plName>Pozostałe elementy komunikatu</unk_3_1_1_2:plName>
                <unk_3_1_1_2:code>PL-320</unk_3_1_1_2:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>ID_instancji_procesu_referencyjnego</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-002</unk_3_1_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data wykreślenia z charakterystyki -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_3_1_1_2:plName>Data wykreślenia z charakterystyki</unk_3_1_1_2:plName>
                        <unk_3_1_1_2:code>PL-512</unk_3_1_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data, od której dany Użytkownik profesjonalny nie jest już przypisany do charakterystyki PP.</xs:documentation>
                    <xs:documentation xml:lang="en">The date from which a given Professional User is no longer assigned to a MP characteristic.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>