<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_7_7_1_1="urn:pl:oire:unk_7_7_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_7_7_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 7.7.1.1. Żądanie informacji o rozliczeniu dodatkowym                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalSettlementDataRequest" type="unk_7_7_1_1:AdditionalSettlementDataRequest"/>
    <xs:complexType name="AdditionalSettlementDataRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>7.7.1.1. Żądanie informacji o rozliczeniu dodatkowym</unk_7_7_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Nagłówek</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-700</unk_7_7_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Kontekst</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-715</unk_7_7_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 7.7.1.1. Payload Żądanie informacji o rozliczeniu dodatkowym -->
            <xs:element name="Payload" type="unk_7_7_1_1:AdditionalSettlementDataRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>7.7.1.1. Payload Żądanie informacji o rozliczeniu dodatkowym</unk_7_7_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 7.7.1.1. Payload Żądanie informacji o rozliczeniu dodatkowym                                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalSettlementDataRequestPayload" type="unk_7_7_1_1:AdditionalSettlementDataRequestPayload"/>
    <xs:complexType name="AdditionalSettlementDataRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>7.7.1.1. Payload Żądanie informacji o rozliczeniu dodatkowym</unk_7_7_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="unk_7_7_1_1:DataSubject" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Przedmiot danych</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-160</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_7_7_1_1:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Informacje podstawowe</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-325</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Przedmiot danych                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="DataSubject" type="unk_7_7_1_1:DataSubject"/>
    <xs:complexType name="DataSubject">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>Przedmiot danych</unk_7_7_1_1:plName>
                <unk_7_7_1_1:code>PL-160</unk_7_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="bdt:DataSubjectType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Przedmiot danych</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-161</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa, czy przekazywane lub udostępniane dane pomiarowe dotyczą Punktu pomiarowego, czy obiektu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether the transferred or shared metering data pertains to a Metering Point or a Metering Facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_7_7_1_1:MeteringPointData_Basic" minOccurs="0" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Dane PP - ogólne</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-300</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_7_7_1_1:FacilityData_Basic" minOccurs="0" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Dane obiektu - ogólne</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-425</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_7_7_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>Dane PP - ogólne</unk_7_7_1_1:plName>
                <unk_7_7_1_1:code>PL-300</unk_7_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Kod PP</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-001</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_transakcji_nadawcy -->
            <xs:element name="SenderReferenceTransactionId" type="bdt:UuidType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>ID_transakcji_nadawcy</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-236</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">UUID transakcji z danymi pomiarowymi, przekazanego przez Operatora do CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">UUID of the metering data transaction transmitted by the Operator to CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_7_7_1_1:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>Dane obiektu - ogólne</unk_7_7_1_1:plName>
                <unk_7_7_1_1:code>PL-425</unk_7_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Identyfikator obiektu</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-424</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_transakcji_nadawcy -->
            <xs:element name="SenderReferenceTransactionId" type="bdt:UuidType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>ID_transakcji_nadawcy</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-236</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">UUID transakcji z danymi pomiarowymi, przekazanego przez Operatora do CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">UUID of the metering data transaction transmitted by the Operator to CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_7_7_1_1:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_7_7_1_1:plName>Informacje podstawowe</unk_7_7_1_1:plName>
                <unk_7_7_1_1:code>PL-325</unk_7_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ zapytania -->
            <xs:element name="QueryType" type="bdt:QueryType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Typ zapytania</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-131</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wskazanie, czy zapytanie dotyczy zakresu dat, czy przekazanego ID_transakcji_nadawcy (UUID).</xs:documentation>
                    <xs:documentation xml:lang="en">Indication of whether the query relates to the date range or the transmitted SenderReferenceTransactionID (UUID).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wersja danych -->
            <xs:element name="DataVersion" type="bdt:DataVersionType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Wersja danych</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-132</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Doprecyzowanie, czy zapytanie CK0578-na podstawie dat dotyczy żądania udostępnienia najnowszej zapisanej w CSIRE wersji danych pomiarowych, czy wszystkich wersji we wskazanym przedziale czasu.</xs:documentation>
                    <xs:documentation xml:lang="en">Clarify whether the CK0578-date-based query refers to a request for the most recent version of metering data stored in CSIRE or all versions in the indicated time period.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data początku okresu -->
            <xs:element name="PeriodStartDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Data początku okresu</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-179</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data początku przedziału czasowego dla którego Użytkownik żąda udostępnienia danych pomiarowych, w przypadku zapytania do IRGUD-k data ta dotyczy okresu rozliczeniowego. Okres wskazany w żądaniu, musi dotyczyć przynajmniej jednego całego (pełnego) okresu przekazanych danych do CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">Date of the beginning of the time period for which the User requests access to metering data, in the case of a request to IRGUD-k this date refers to the billing period. The period indicated in the request, must relate to at least one entire (complete) period of data submitted to CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data końca okresu -->
            <xs:element name="PeriodEndDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_7_7_1_1:plName>Data końca okresu</unk_7_7_1_1:plName>
                        <unk_7_7_1_1:code>PL-180</unk_7_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data końca przedziału czasowego dla którego Użytkownik żąda udostępnienia danych pomiarowych, w przypadku zapytania do IRGUD-k data ta dotyczy okresu rozliczeniowego. Okres wskazany w żądaniu, musi dotyczyć przynajmniej jednego całego (pełnego) okresu przekazanych danych do CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">Date of the end of the time period for which the User requests access to metering data, in the case of a request to IRGUD-k, this date refers to the billing period. The period indicated in the request, must relate to at least one entire (complete) period of data transmitted to CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>