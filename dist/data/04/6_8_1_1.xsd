<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_8_1_1="urn:pl:oire:unk_6_8_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_8_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.8.1.1. Przekazanie informacji o saldzie przedpłaty                                                                                         ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PrepayBalanceInformationNotification" type="unk_6_8_1_1:PrepayBalanceInformationNotification"/>
    <xs:complexType name="PrepayBalanceInformationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_8_1_1:plName>6.8.1.1. Przekazanie informacji o saldzie przedpłaty</unk_6_8_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Nagłówek</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-700</unk_6_8_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Kontekst</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-715</unk_6_8_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.8.1.1. Payload Przekazanie informacji o saldzie przedpłaty -->
            <xs:element name="Payload" type="unk_6_8_1_1:PrepayBalanceInformationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>6.8.1.1. Payload Przekazanie informacji o saldzie przedpłaty</unk_6_8_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.8.1.1. Payload Przekazanie informacji o saldzie przedpłaty                                                                                 ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PrepayBalanceInformationNotificationPayload" type="unk_6_8_1_1:PrepayBalanceInformationNotificationPayload"/>
    <xs:complexType name="PrepayBalanceInformationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_8_1_1:plName>6.8.1.1. Payload Przekazanie informacji o saldzie przedpłaty</unk_6_8_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Rekord operacji masowej -->
            <xs:element name="PrepayBalanceInformation" type="unk_6_8_1_1:PrepayBalanceInformation" minOccurs="1" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Rekord operacji masowej</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-711</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Rekord operacji masowej                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PrepayBalanceInformation" type="unk_6_8_1_1:PrepayBalanceInformation"/>
    <xs:complexType name="PrepayBalanceInformation">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_8_1_1:plName>Rekord operacji masowej</unk_6_8_1_1:plName>
                <unk_6_8_1_1:code>PL-711</unk_6_8_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator transakcji -->
            <xs:element name="ReferenceTransactionId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Identyfikator transakcji</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-710</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator rekordu nadawany przez Operatora, używany do korelacji rekordu żądania do rekordu wyniku</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier assigned by Operator, used for batch record identification</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_6_8_1_1:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Dane PP - ogólne</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-300</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Stan salda przedplaty -->
            <xs:element name="PrepaymentBalance" type="unk_6_8_1_1:PrepaymentBalance" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Stan salda przedplaty</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-521</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_6_8_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_8_1_1:plName>Dane PP - ogólne</unk_6_8_1_1:plName>
                <unk_6_8_1_1:code>PL-300</unk_6_8_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Kod PP</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-001</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Stan salda przedplaty                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="PrepaymentBalance" type="unk_6_8_1_1:PrepaymentBalance"/>
    <xs:complexType name="PrepaymentBalance">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_8_1_1:plName>Stan salda przedplaty</unk_6_8_1_1:plName>
                <unk_6_8_1_1:code>PL-521</unk_6_8_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data i czas wyznaczenia salda -->
            <xs:element name="BalanceDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Data i czas wyznaczenia salda</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-522</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa datę i czas wyznacznenia przez SE stanu salda.</xs:documentation>
                    <xs:documentation xml:lang="en">Specifies the date and time of Energy Supplier's balance determination.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Stan salda -->
            <xs:element name="Balance" type="bdt:BalanceType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Stan salda</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-523</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa pozostały dla Użytkownika KSE stan salda do wykorzystania. Stan salda jest aktualny tylko w we wskazanej dacie i czasie określonej w komunikacie. Możliwość podania wartości ujemnej.</xs:documentation>
                    <xs:documentation xml:lang="en">Specifies the balance remaining for the KSE User to use. The balance balance is valid only at the indicated date and time specified in the message. Negative value can be used</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Jednostka salda -->
            <xs:element name="BalanceUnit" type="bdt:UnitCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_8_1_1:plName>Jednostka salda</unk_6_8_1_1:plName>
                        <unk_6_8_1_1:code>PL-524</unk_6_8_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa jednostkę salda podaną w stanie salda.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines the balance unit given in the balance status.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>