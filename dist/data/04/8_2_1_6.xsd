<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_8_2_1_6="urn:pl:oire:unk_8_2_1_6:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_8_2_1_6:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 8.2.1.6. Żądanie realizacji załączenia                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ConnectionRealisationRequest" type="unk_8_2_1_6:ConnectionRealisationRequest"/>
    <xs:complexType name="ConnectionRealisationRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_8_2_1_6:plName>8.2.1.6. Żądanie realizacji załączenia</unk_8_2_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Nagłówek</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-700</unk_8_2_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Kontekst</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-715</unk_8_2_1_6:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 8.2.1.6. Payload Żądanie realizacji załączenia -->
            <xs:element name="Payload" type="unk_8_2_1_6:ConnectionRealisationRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>8.2.1.6. Payload Żądanie realizacji załączenia</unk_8_2_1_6:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 8.2.1.6. Payload Żądanie realizacji załączenia                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="ConnectionRealisationRequestPayload" type="unk_8_2_1_6:ConnectionRealisationRequestPayload"/>
    <xs:complexType name="ConnectionRealisationRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_8_2_1_6:plName>8.2.1.6. Payload Żądanie realizacji załączenia</unk_8_2_1_6:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_8_2_1_6:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Dane PP - ogólne</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-300</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - podmioty obsługujące PP -->
            <xs:element name="MeteringPointData_Operators" type="unk_8_2_1_6:MeteringPointData_Operators" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Dane PP - podmioty obsługujące PP</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-303</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_8_2_1_6:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Pozostałe elementy komunikatu</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-320</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_8_2_1_6:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_8_2_1_6:plName>Dane PP - ogólne</unk_8_2_1_6:plName>
                <unk_8_2_1_6:code>PL-300</unk_8_2_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Kod PP</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-001</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - podmioty obsługujące PP                                                                                                            ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Operators" type="unk_8_2_1_6:MeteringPointData_Operators"/>
    <xs:complexType name="MeteringPointData_Operators">
        <xs:annotation>
            <xs:appinfo>
                <unk_8_2_1_6:plName>Dane PP - podmioty obsługujące PP</unk_8_2_1_6:plName>
                <unk_8_2_1_6:code>PL-303</unk_8_2_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>ID_SE</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-019</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_8_2_1_6:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_8_2_1_6:plName>Pozostałe elementy komunikatu</unk_8_2_1_6:plName>
                <unk_8_2_1_6:code>PL-320</unk_8_2_1_6:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>ID_instancji_procesu_referencyjnego</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-002</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wnioskowana data załączenia -->
            <xs:element name="EffectiveDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Wnioskowana data załączenia</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-145</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wnioskowana data załączenia dostaw energii.</xs:documentation>
                    <xs:documentation xml:lang="en">Requested date of attachment of energy supply.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_błędnego_procesu -->
            <xs:element name="FailedProcessIdentifier" type="bdt:UuidType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>ID_błędnego_procesu</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-234</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Standard nadawania kodów instancji procesów.</xs:documentation>
                    <xs:documentation xml:lang="en">Standard for assigning process instance codes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna załączenia dostarczania e.e. -->
            <xs:element name="ConnectionReason" type="bdt:KseUserConnectionReasonType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_8_2_1_6:plName>Przyczyna załączenia dostarczania e.e.</unk_8_2_1_6:plName>
                        <unk_8_2_1_6:code>PL-146</unk_8_2_1_6:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie powodu załączenia dostarczania energii elektrycznej.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the reason for switching on the supply of electricity.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>