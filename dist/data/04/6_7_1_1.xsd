<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_7_1_1="urn:pl:oire:unk_6_7_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_7_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.7.1.1. Przekazanie informacji                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RatingMethodGroupInformationNotification" type="unk_6_7_1_1:RatingMethodGroupInformationNotification"/>
    <xs:complexType name="RatingMethodGroupInformationNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>6.7.1.1. Przekazanie informacji</unk_6_7_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Nagłówek</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-700</unk_6_7_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Kontekst</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-715</unk_6_7_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.7.1.1. Payload Przekazanie informacji -->
            <xs:element name="Payload" type="unk_6_7_1_1:RatingMethodGroupInformationNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>6.7.1.1. Payload Przekazanie informacji</unk_6_7_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.7.1.1. Payload Przekazanie informacji                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RatingMethodGroupInformationNotificationPayload" type="unk_6_7_1_1:RatingMethodGroupInformationNotificationPayload"/>
    <xs:complexType name="RatingMethodGroupInformationNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>6.7.1.1. Payload Przekazanie informacji</unk_6_7_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_6_7_1_1:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Pozostałe elementy komunikatu</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-320</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacja o sprzedawcy -->
            <xs:element name="SupplierData" type="unk_6_7_1_1:SupplierData" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Informacja o sprzedawcy</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-362</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacja o grupie taryfowej i obszarze sieci pomiarowej -->
            <xs:element name="RatingMethodOrMeteringGridAreaInformation" type="unk_6_7_1_1:RatingMethodOrMeteringGridAreaInformation" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Informacja o grupie taryfowej i obszarze sieci pomiarowej</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-363</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_6_7_1_1:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Pozostałe elementy komunikatu</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-320</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Rodzaj informacji -->
            <xs:element name="InformationType" type="bdt:InformationType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Rodzaj informacji</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-361</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy komunikat dotyczy przekazania informacji o sprzedawcy, czy o grupie taryfowej na terenie działania Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the message concerns the transfer of supplier information or tariff group information in the Operator's area of operation.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacja o sprzedawcy                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="SupplierData" type="unk_6_7_1_1:SupplierData"/>
    <xs:complexType name="SupplierData">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Informacja o sprzedawcy</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-362</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_SE -->
            <xs:element name="SupplierIdentifier" type="bdt:EicIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>ID_SE</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-019</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący sprzedawcę - zgodny z EIC.</xs:documentation>
                    <xs:documentation xml:lang="en">EIC code identifying the Energy Supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data początku -->
            <xs:element name="StartDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Data początku</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-279</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data początkowa (od początku wskazanej doby), z którą Sprzedawca może pełnić daną funkcję sprzedawcy z urzędu/zobowiązanego.</xs:documentation>
                    <xs:documentation xml:lang="en">The starting date (from the beginning of the indicated day) with which the Energy Supplier can perform the given function of ex-officio/obliged energy supplier.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacja o grupie taryfowej i obszarze sieci pomiarowej                                                                                    ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RatingMethodOrMeteringGridAreaInformation" type="unk_6_7_1_1:RatingMethodOrMeteringGridAreaInformation"/>
    <xs:complexType name="RatingMethodOrMeteringGridAreaInformation">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Informacja o grupie taryfowej i obszarze sieci pomiarowej</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-363</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ komunikatu -->
            <xs:element name="MessageType" type="bdt:MessageType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Typ komunikatu</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-364</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy komunikat dotyczy dodania utworzenia w CSIRE nowej grupy taryfowej obsługiwanej przez Operatora, czy likwidacji istniejącej grupy taryfowej przez Operatora, czy utworzenia w CSIRE obszaru sieci dla danego Operatora, czy likwidacji istniejąceego obszaru sieci dla danego Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether the message concerns the addition of a new tariff group operated by the Operator in CSIRE, or the removal of an existing tariff group by the Operator, or the creation of a metering grid area in CSIRE for a given Operator, or the removal of an existing metering grid area for a given Operator.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dodanie grupy taryfowej -->
            <xs:element name="RatingMethodGroupCreation" type="unk_6_7_1_1:RatingMethodGroupCreation" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Dodanie grupy taryfowej</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-365</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Likwidacja grupy taryfowej -->
            <xs:element name="RatingMethodGroupRemoval" type="unk_6_7_1_1:RatingMethodGroupRemoval" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Likwidacja grupy taryfowej</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-367</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Utworzenie obszaru sieci dla danego Operatora -->
            <xs:element name="MeteringGridAreaCreation" type="unk_6_7_1_1:MeteringGridAreaCreation" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Utworzenie obszaru sieci dla danego Operatora</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-427</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Likwidacja obszaru sieci dla danego Operatora -->
            <xs:element name="MeteringGridAreaRemoval" type="unk_6_7_1_1:MeteringGridAreaRemoval" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Likwidacja obszaru sieci dla danego Operatora</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-428</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dodanie grupy taryfowej                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RatingMethodGroupCreation" type="unk_6_7_1_1:RatingMethodGroupCreation"/>
    <xs:complexType name="RatingMethodGroupCreation">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Dodanie grupy taryfowej</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-365</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Grupa taryfowa -->
            <xs:element name="TariffGroup" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Grupa taryfowa</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-085</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Grupa taryfowa zgodna z Taryfą OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">Tariff group in accordance with the DSO Tariff.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data początku obowiązywania -->
            <xs:element name="ValidFrom" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Data początku obowiązywania</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-366</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie daty, od której dana grupa taryfowa będzie dostępna na terenie Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the date from which the tariff group will be available on the Operator's premises.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Likwidacja grupy taryfowej                                                                                                                   ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="RatingMethodGroupRemoval" type="unk_6_7_1_1:RatingMethodGroupRemoval"/>
    <xs:complexType name="RatingMethodGroupRemoval">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Likwidacja grupy taryfowej</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-367</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Grupa taryfowa -->
            <xs:element name="TariffGroup" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Grupa taryfowa</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-085</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Grupa taryfowa zgodna z Taryfą OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">Tariff group in accordance with the DSO Tariff.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data końca obowiązywania (włącznie) -->
            <xs:element name="ValidToInclusive" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Data końca obowiązywania (włącznie)</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-368</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie daty, do kiedy grupa taryfowa będzie dostępna na terenie Operatora (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the date until which the tariff group will be available on the Operator's premises (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Utworzenie obszaru sieci dla danego Operatora                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringGridAreaCreation" type="unk_6_7_1_1:MeteringGridAreaCreation"/>
    <xs:complexType name="MeteringGridAreaCreation">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Utworzenie obszaru sieci dla danego Operatora</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-427</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obszaru -->
            <xs:element name="MeteringGridAreaCode" type="bdt:NetworkAreaIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Identyfikator obszaru</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-014</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Obszar sieci dla danego Operatora</xs:documentation>
                    <xs:documentation xml:lang="en">Operator Metering Grid Area</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data początku obowiązywania -->
            <xs:element name="ValidFrom" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Data początku obowiązywania</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-366</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie daty, od której dany obszar sieci będzie dostępny na terenie Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">​Date from which a given Metering Grid Area will be available on the Operator's area.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Likwidacja obszaru sieci dla danego Operatora                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringGridAreaRemoval" type="unk_6_7_1_1:MeteringGridAreaRemoval"/>
    <xs:complexType name="MeteringGridAreaRemoval">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_7_1_1:plName>Likwidacja obszaru sieci dla danego Operatora</unk_6_7_1_1:plName>
                <unk_6_7_1_1:code>PL-428</unk_6_7_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.4.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obszaru -->
            <xs:element name="MeteringGridAreaCode" type="bdt:NetworkAreaIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Identyfikator obszaru</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-014</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Obszar sieci dla danego Operatora</xs:documentation>
                    <xs:documentation xml:lang="en">Operator Metering Grid Area</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data końca obowiązywania (włącznie) -->
            <xs:element name="ValidToInclusive" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_7_1_1:plName>Data końca obowiązywania (włącznie)</unk_6_7_1_1:plName>
                        <unk_6_7_1_1:code>PL-368</unk_6_7_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie daty, do kiedy obszar sieci będzie dostępny na terenie Operatora (włącznie).</xs:documentation>
                    <xs:documentation xml:lang="en">Date until which the Metering Grid Area will be available on the Operator's area (inclusive).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>