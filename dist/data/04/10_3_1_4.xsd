<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_10_3_1_4="urn:pl:oire:unk_10_3_1_4:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_10_3_1_4:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.3.1.4. Powiadomienie o danych obiektu                                                                                                     ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityDataResponse" type="unk_10_3_1_4:FacilityDataResponse"/>
    <xs:complexType name="FacilityDataResponse">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>10.3.1.4. Powiadomienie o danych obiektu</unk_10_3_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Nagłówek</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-700</unk_10_3_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Kontekst</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-715</unk_10_3_1_4:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 10.3.1.4. Payload Powiadomienie o danych obiektu -->
            <xs:element name="Payload" type="unk_10_3_1_4:FacilityDataResponsePayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>10.3.1.4. Payload Powiadomienie o danych obiektu</unk_10_3_1_4:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 10.3.1.4. Payload Powiadomienie o danych obiektu                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityDataResponsePayload" type="unk_10_3_1_4:FacilityDataResponsePayload"/>
    <xs:complexType name="FacilityDataResponsePayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>10.3.1.4. Payload Powiadomienie o danych obiektu</unk_10_3_1_4:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_10_3_1_4:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Pozostałe elementy komunikatu</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-320</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_10_3_1_4:FacilityData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Dane obiektu - ogólne</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-425</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Punkty pomiarowe w obiekcie -->
            <xs:element name="FacilityMeteringPoints" type="unk_10_3_1_4:FacilityMeteringPoints" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Punkty pomiarowe w obiekcie</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-466</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_10_3_1_4:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>Pozostałe elementy komunikatu</unk_10_3_1_4:plName>
                <unk_10_3_1_4:code>PL-320</unk_10_3_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>ID_instancji_procesu_referencyjnego</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-002</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_10_3_1_4:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>Dane obiektu - ogólne</unk_10_3_1_4:plName>
                <unk_10_3_1_4:code>PL-425</unk_10_3_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Identyfikator obiektu</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-424</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nazwa obiektu -->
            <xs:element name="FacilityName" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Nazwa obiektu</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-426</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa obiektu, o ile została nadana.</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the facility, if assigned.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ obiektu -->
            <xs:element name="FacilityType" type="bdt:FacilityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Typ obiektu</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-423</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu obiektu, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the facility type, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy posiada szczególne warunki świadczenia usług? -->
            <xs:element name="HasSpecificServiceConditions" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Czy posiada szczególne warunki świadczenia usług?</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-118</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego obiektu pomiarowego zachodzą nietypowe warunki świadczenia usług.
Dotyczy przypadków, gdy występuje różnica pomiędzy warunkami świadczenia usług dla PP wchodzących w skład obiektu oraz całym obiektem pomiarowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether abnormal service conditions exist for a given Metering Facility.
Applies to cases where there is a difference between the service conditions for the MPs included in the facility and the entire metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szczególne warunki świadczenia usług -->
            <xs:element name="SpecificTermsOfService" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Szczególne warunki świadczenia usług</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-370</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie szczegółowych warunków świadczenia usług. Dotyczy przypadków, gdy występuje różnica pomiędzy warunkami świadczenia usług dla PP wchodzących w skład obiektu oraz całym obiektem pomiarowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the detailed conditions for the provision of services. Applies to cases where there is a difference between the terms of service for MPs included in the facility and the entire metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data utworzenia Obiektu Pomiarowego -->
            <xs:element name="CreationDate" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Data utworzenia Obiektu Pomiarowego</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-388</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data rozpoczęcia działania Obiektu Pomiarowego.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Obiekt sumujący -->
            <xs:element name="AggregatingFacility" type="unk_10_3_1_4:AggregatingFacility" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Obiekt sumujący</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-453</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wspólnota energetyczna -->
            <xs:element name="EnergyCommunity" type="unk_10_3_1_4:EnergyCommunity" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Wspólnota energetyczna</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-455</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wspólnota prosumencka -->
            <xs:element name="ProsumerCommunity" type="unk_10_3_1_4:ProsumerCommunity" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Wspólnota prosumencka</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-464</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Beneficjent systemu wsparcia -->
            <xs:element name="SupportSystemBeneficiary" type="unk_10_3_1_4:SupportSystemBeneficiary" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Beneficjent systemu wsparcia</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-549</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Obiekt sumujący                                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AggregatingFacility" type="unk_10_3_1_4:AggregatingFacility"/>
    <xs:complexType name="AggregatingFacility">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>Obiekt sumujący</unk_10_3_1_4:plName>
                <unk_10_3_1_4:code>PL-453</unk_10_3_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ obiektu sumującego -->
            <xs:element name="AggregatingFacilityType" type="bdt:AggregatingFacilityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Typ obiektu sumującego</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-454</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy sumator jest urządzeniem pomiarowym na sieci, czy sumowanie następuje w systemie bilingowym Operatora.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the aggregator is a metering device on the network, or whether the aggregation is done in the Operator's billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Rodzaj obiektu sumującego -->
            <xs:element name="AggregatingFacilityDetails" type="bdt:String100_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Rodzaj obiektu sumującego</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-437</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Doprecyzowanie, czego dotyczy rozliczanie z obiektem sumującym, zgodnie z zawartą umową z Użytkownikiem KSE.</xs:documentation>
                    <xs:documentation xml:lang="en">Clarification of what the billing to the aggregating facility is for, according to the agreement with the KSE User.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wspólnota energetyczna                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="EnergyCommunity" type="unk_10_3_1_4:EnergyCommunity"/>
    <xs:complexType name="EnergyCommunity">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>Wspólnota energetyczna</unk_10_3_1_4:plName>
                <unk_10_3_1_4:code>PL-455</unk_10_3_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Rodzaj wspólnoty energetycznej -->
            <xs:element name="EnergyCommunityType" type="bdt:EnergyCommunityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Rodzaj wspólnoty energetycznej</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-513</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie rodzaju wspólnoty energetycznej.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of energy community.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zawarta UD? -->
            <xs:element name="HasDistributionAgreement" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Czy zawarta UD?</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-514</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy wspólnota energetyczna zawarła umowę o świadczenie usług dystrybucji energii elektrycznej z OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the energy community has entered into an agreement for the provision of electricity distribution services with the DSO.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data rozpoczęcia -->
            <xs:element name="StartDate" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Data rozpoczęcia</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-071</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data wejścia w życie umowy zawartej ze wspólnotą energetyczną.</xs:documentation>
                    <xs:documentation xml:lang="en">The effective date of the agreement with the energy community.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ strony umowy -->
            <xs:element name="AgreementPartyType" type="bdt:KseUserType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Typ strony umowy</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-456</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu strony umowy zawartej przez wspólnotę energetyczną.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of party to the agreement entered into by the energy community.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane strony umowy wspólnoty energetycznej -->
            <xs:element name="CommunityAgreementParty" type="unk_10_3_1_4:CommunityAgreementParty" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>Dane strony umowy wspólnoty energetycznej</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-457</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane strony umowy wspólnoty energetycznej                                                                                                    ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="CommunityAgreementParty" type="unk_10_3_1_4:CommunityAgreementParty"/>
    <xs:complexType name="CommunityAgreementParty">
        <xs:annotation>
            <xs:appinfo>
                <unk_10_3_1_4:plName>Dane strony umowy wspólnoty energetycznej</unk_10_3_1_4:plName>
                <unk_10_3_1_4:code>PL-457</unk_10_3_1_4:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>PESEL</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-028</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer PESEL identyfikujący stronę umowy</xs:documentation>
                    <xs:documentation xml:lang="en">PESEL number identifying the contracting party</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- NIP -->
            <xs:element name="Nip" type="bdt:NipType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>NIP</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-029</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer NIP identyfikujący stronę umowy</xs:documentation>
                    <xs:documentation xml:lang="en">NIP number identifying the party to the agreement</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- KRS -->
            <xs:element name="Krs" type="bdt:KrsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_10_3_1_4:plName>KRS</unk_10_3_1_4:plName>
                        <unk_10_3_1_4:code>PL-030</unk_10_3_1_4:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer KRS identyfikujący stronę umowy</xs:documentation>
                    <xs:documentation xml:lang="en">KRS number identifying the contracting party</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ identyfikatora -->
