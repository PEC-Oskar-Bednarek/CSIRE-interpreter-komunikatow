<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_1_2_1_5="urn:pl:oire:unk_1_2_1_5:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_1_2_1_5:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
