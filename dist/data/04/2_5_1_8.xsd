    <xs:element name="KseUserData_Primary" type="unk_2_5_1_8:KseUserData_Primary"/>
    <xs:complexType name="KseUserData_Primary">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane Użytkownika KSE - podstawowe</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-311</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ Użytkownika KSE -->
            <xs:element name="KseUserType" type="bdt:KseUserType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Typ Użytkownika KSE</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-024</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu Użytkownika KSE wprowadzonego do Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the type of the KSE User entered in the Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - identyfikacyjne -->
            <xs:element name="KseUserData_Identifiers" type="unk_2_5_1_8:KseUserData_Identifiers" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane Użytkownika KSE - identyfikacyjne</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-312</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - identyfikacyjne                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Identifiers" type="unk_2_5_1_8:KseUserData_Identifiers"/>
    <xs:complexType name="KseUserData_Identifiers">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane Użytkownika KSE - identyfikacyjne</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-312</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- PESEL -->
            <xs:element name="Pesel" type="bdt:PeselType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>PESEL</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-028</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer PESEL identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">PESEL number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- NIP -->
            <xs:element name="Nip" type="bdt:NipType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>NIP</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-029</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer NIP identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">NIP number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- KRS -->
            <xs:element name="Krs" type="bdt:KrsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>KRS</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-030</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer KRS identyfikujący użytkownika.</xs:documentation>
                    <xs:documentation xml:lang="en">KRS number identifying the user.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ identyfikatora -->
            <xs:element name="IdentifierType" type="bdt:UserIdentifierType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Typ identyfikatora</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-032</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sposób nadania identyfikatora osobie fizycznej nierezydent lub rezydent bez PESEL.</xs:documentation>
                    <xs:documentation xml:lang="en">The method of assigning an identifier to an individual non-resident or resident without PESEL.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Inny identyfikator osoby fizycznej -->
            <xs:element name="CustomKseUserIdentifier" type="bdt:IdentityDocumentNumberType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Inny identyfikator osoby fizycznej</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-033</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator użytkownika, dla którego nie jest znany PESEL. W przypadku nadania numeru przez Operatora, struktura identyfikatora powinna wyglądać następująco: [EIC] [UKSE] [UNIKATOWE_DOPEŁNIENIE_W_FORMACIE_12345678901]</xs:documentation>
                    <xs:documentation xml:lang="en">Identification for a KSE user without PESEL. The identifier structure should look as follows: [EIC] [UKSE] [UNIQUE_ADDENDUM_IN_FORMAT_12345678901].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Global NIP -->
            <xs:element name="GlobalTaxIdentification" type="bdt:GlobalTaxIdentificationType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Global NIP</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-034</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer identyfikujący użytkownika typu jednostka organizacyjna nieposiadająca numeru NIP, w tym nierezydent.</xs:documentation>
                    <xs:documentation xml:lang="en">Number identifying the user of the type organizational entity without NIP identifier (e.g. non-resident).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry handlowe - ogólne                                                                                                                  ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BusinessData_Basic" type="unk_2_5_1_8:BusinessData_Basic"/>
    <xs:complexType name="BusinessData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Parametry handlowe - ogólne</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-316</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Charakter odbioru -->
            <xs:element name="EnergyConsumptionType" type="bdt:EnergyConsumptionType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Charakter odbioru</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-057</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie charakteru odbioru, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the nature of the Consumption Point, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szacowany wolumen roczny -->
            <xs:element name="EstimatedAnnualVolume" type="bdt:EstimatedAnnualVolumeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Szacowany wolumen roczny</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-068</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Szacowana lub deklarowana wartość średniorocznego zapotrzebowania na energię, wyrażona w [kWh].</xs:documentation>
                    <xs:documentation xml:lang="en">The estimated or declared value of the average annual energy demand, expressed in [kWh].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Harmonogram odczytu -->
            <xs:element name="ReadingSchedule" type="bdt:ReadingScheduleType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Harmonogram odczytu</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-069</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Miesiąc startowy odczytu danych z układu pomiarowo-rozliczeniowego, kod CK0123 dotyczy przypadków Ryczałtu lub sytuacji, gdy dla danego PP nie został określony harmonogram odczytu.</xs:documentation>
                    <xs:documentation xml:lang="en">Start month of reading data from the metering and billing system, code CK0123 applies to cases of Lump Sum or situations where no reading schedule has been specified for the MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Możliwość wstrzymania windykacyjnego -->
            <xs:element name="CanBeSuspendedForDebtCollection" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Możliwość wstrzymania windykacyjnego</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-055</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego Punktu poboru energii dopuszczalne jest wstrzymywanie dostaw energii.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether withholding of energy supply is allowed for a given Energy Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - warunki świadczenia usług -->
            <xs:element name="BusinessData_TermsOfService" type="unk_2_5_1_8:BusinessData_TermsOfService" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Parametry handlowe - warunki świadczenia usług</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-321</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - umowa dystrybucyjna/przesyłowa -->
            <xs:element name="BusinessData_DistributionAgreement" type="unk_2_5_1_8:BusinessData_DistributionAgreement" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Parametry handlowe - umowa dystrybucyjna/przesyłowa</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-317</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry handlowe - warunki świadczenia usług                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BusinessData_TermsOfService" type="unk_2_5_1_8:BusinessData_TermsOfService"/>
    <xs:complexType name="BusinessData_TermsOfService">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Parametry handlowe - warunki świadczenia usług</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-321</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy posiada szczególne warunki świadczenia usług? -->
            <xs:element name="HasSpecificServiceConditions" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy posiada szczególne warunki świadczenia usług?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-118</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego Punktu poboru energii lub obiektu zachodzą nietypowe warunki świadczenia usług.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether abnormal service conditions exist for a given MP or Facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Szczególne warunki świadczenia usług -->
            <xs:element name="SpecificTermsOfService" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Szczególne warunki świadczenia usług</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-370</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie szczegółowych warunków świadczenia usług.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of detailed service conditions.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Jednorazowa przerwa planowana -->
            <xs:element name="PlannedOneOffInterruption" type="bdt:PositiveInteger4_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Jednorazowa przerwa planowana</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-371</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dopuszczalny czas pojedynczej planowanej przerwy (nie uwzględniająca warunków szczególnych jeżeli zostały określone) w dostarczaniu energii elektrycznej, określony w godzinach.</xs:documentation>
                    <xs:documentation xml:lang="en">Permissible time of a single planned interruption (not taking into account special conditions if specified) in the supply of electricity, specified in hours.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Jednorazowa przerwa nieplanowana -->
            <xs:element name="UnplannedOneOffInterruption" type="bdt:PositiveInteger4_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Jednorazowa przerwa nieplanowana</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-116</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Dopuszczalny czas pojedynczej nieplanowanej przerwy (nie uwzględniająca warunków szczególnych jeżeli zostały określone) w dostarczaniu energii elektrycznej, określony w godzinach.</xs:documentation>
                    <xs:documentation xml:lang="en">Permissible time of a single unplanned interruption (not including special conditions if specified) in the supply of electricity, specified in hours.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Suma przerw planowanych w ciągu roku -->
            <xs:element name="SumOfPlannedInterruptionsDuringTheYear" type="bdt:PositiveInteger4_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Suma przerw planowanych w ciągu roku</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-117</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Suma czasów przerw planowanych (nie uwzględniająca warunków szczególnych jeżeli zostały określone) w ciągu roku, określona w godzinach.</xs:documentation>
                    <xs:documentation xml:lang="en">The sum of the times of scheduled breaks (not taking into account specific conditions if specified) during the year, specified in hours.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Suma przerw nieplanowanych w ciągu roku -->
            <xs:element name="SumOfUnplannedInterruptionsDuringTheYear" type="bdt:PositiveInteger4_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Suma przerw nieplanowanych w ciągu roku</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-087</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Suma czasów przerw nieplanowanych (nie uwzględniająca warunków szczególnych jeżeli zostały określone) w ciągu roku, określona w godzinach.</xs:documentation>
                    <xs:documentation xml:lang="en">The sum of times of unscheduled breaks (not including specific conditions if specified) during the year, specified in hours.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przekroczenie mocy umownej -->
            <xs:element name="HasExcessPowerBilling" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Przekroczenie mocy umownej</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-350</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa, czy dla danego PP stosowane jest rozliczanie za przekroczenie mocy umownej.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether billing for over contracted power is applied for a given MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ponadnormatywny pobór energii biernej -->
            <xs:element name="HasExcessReactivePowerBilling" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Ponadnormatywny pobór energii biernej</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-351</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa, czy dla danego PP stosowane jest rozliczanie za ponad umowny pobór energii biernej.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether billing for over contracted reactive energy consumption is applied for a given MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- tg φ0 Q1 -->
            <xs:element name="TgPhiQ1" type="bdt:TgPhiValue_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>tg φ0 Q1</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-480</unk_2_5_1_8:code>
