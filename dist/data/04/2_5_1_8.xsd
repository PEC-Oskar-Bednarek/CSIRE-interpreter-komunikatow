                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kontekst</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-715</unk_2_5_1_8:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.5.1.8. Payload Powiadomienie o zawarciu USC -->
            <xs:element name="Payload" type="unk_2_5_1_8:NetworkAgreementSigningNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
