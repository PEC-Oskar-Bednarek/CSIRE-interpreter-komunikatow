    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.5.1.8. Powiadomienie o zawarciu USC                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="NetworkAgreementSigningNotification" type="unk_2_5_1_8:NetworkAgreementSigningNotification"/>
