                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 2.5.1.8. Payload Powiadomienie o zawarciu USC                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="NetworkAgreementSigningNotificationPayload" type="unk_2_5_1_8:NetworkAgreementSigningNotificationPayload"/>
    <xs:complexType name="NetworkAgreementSigningNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>2.5.1.8. Payload Powiadomienie o zawarciu USC</unk_2_5_1_8:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_2_5_1_8:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane PP - ogólne</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-300</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - ogólne -->
            <xs:element name="KseUserData_Basic" type="unk_2_5_1_8:KseUserData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane Użytkownika KSE - ogólne</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-395</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - podstawowe -->
            <xs:element name="KseUserData_Primary" type="unk_2_5_1_8:KseUserData_Primary" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane Użytkownika KSE - podstawowe</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-311</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - ogólne -->
            <xs:element name="BusinessData_Basic" type="unk_2_5_1_8:BusinessData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Parametry handlowe - ogólne</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-316</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_2_5_1_8:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane PP - ogólne</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-300</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kod PP</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-001</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Basic" type="unk_2_5_1_8:KseUserData_Basic"/>
    <xs:complexType name="KseUserData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane Użytkownika KSE - ogólne</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-395</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Czy odbiorca końcowy? -->
            <xs:element name="IsEndUser" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy odbiorca końcowy?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-393</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy Użytkownik KSE jest odbiorcą końcowym w rozumieniu przepisów.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the KSE User is a final user as defined by the regulations.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy wiele podmiotów? -->
            <xs:element name="HasMultipleEntities" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy wiele podmiotów?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-400</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy do Punktu pomiarowego ma być przypisany więcej niż jeden podmiot (osoba fizyczna lub prawna).</xs:documentation>
                    <xs:documentation xml:lang="en">Determine whether more than one entity (individual or legal entity) is to be assigned to a Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - adresowe -->
            <xs:element name="KseUserData_Address" type="unk_2_5_1_8:KseUserData_Address" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane Użytkownika KSE - adresowe</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-313</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane Użytkownika KSE - korespondencyjne -->
            <xs:element name="KseUserData_MailingAddress" type="unk_2_5_1_8:KseUserData_MailingAddress" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Dane Użytkownika KSE - korespondencyjne</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-314</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - adresowe                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_Address" type="unk_2_5_1_8:KseUserData_Address"/>
    <xs:complexType name="KseUserData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane Użytkownika KSE - adresowe</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-313</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kraj</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-037</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Miejscowość</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-038</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości</xs:documentation>
                    <xs:documentation xml:lang="en">Name of city</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy zastosowano podział na ulice?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-559</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu Użytkownika KSE w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this KSE User address.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy ulica zgodna z TERYT?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-585</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kod pocztowy</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-039</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Ulica</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-040</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr budynku</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-041</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu/ mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr lokalu/ mieszkania</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-042</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr działki</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-043</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>TERYT</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-044</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - korespondencyjne                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="KseUserData_MailingAddress" type="unk_2_5_1_8:KseUserData_MailingAddress"/>
    <xs:complexType name="KseUserData_MailingAddress">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_8:plName>Dane Użytkownika KSE - korespondencyjne</unk_2_5_1_8:plName>
                <unk_2_5_1_8:code>PL-314</unk_2_5_1_8:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Nazwa adresata -->
            <xs:element name="RecipientName" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nazwa adresata</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-054</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa adresata dla adresu do korespondencji</xs:documentation>
                    <xs:documentation xml:lang="en">Addressee name for mailing address</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kraj</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-045</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Miejscowość</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-046</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości</xs:documentation>
                    <xs:documentation xml:lang="en">Name of city</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy zastosowano podział na ulice?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-560</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu Użytkownika KSE w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this KSE User address.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Czy ulica zgodna z TERYT?</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-586</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Kod pocztowy</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-047</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Ulica</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-048</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr budynku</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-049</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu/ mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr lokalu/ mieszkania</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-050</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>Nr działki</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-051</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_8:plName>TERYT</unk_2_5_1_8:plName>
                        <unk_2_5_1_8:code>PL-052</unk_2_5_1_8:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane Użytkownika KSE - podstawowe                                                                                                            ==== -->
