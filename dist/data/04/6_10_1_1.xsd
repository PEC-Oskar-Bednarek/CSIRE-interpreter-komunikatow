<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_6_10_1_1="urn:pl:oire:unk_6_10_1_1:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_6_10_1_1:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.10.1.1. Przekazanie rozliczenia dodatkowego                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalSettlementRequest" type="unk_6_10_1_1:AdditionalSettlementRequest"/>
    <xs:complexType name="AdditionalSettlementRequest">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>6.10.1.1. Przekazanie rozliczenia dodatkowego</unk_6_10_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Nagłówek</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-700</unk_6_10_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Kontekst</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-715</unk_6_10_1_1:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 6.10.1.1. Payload Przekazanie rozliczenia dodatkowego -->
            <xs:element name="Payload" type="unk_6_10_1_1:AdditionalSettlementRequestPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>6.10.1.1. Payload Przekazanie rozliczenia dodatkowego</unk_6_10_1_1:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 6.10.1.1. Payload Przekazanie rozliczenia dodatkowego                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalSettlementRequestPayload" type="unk_6_10_1_1:AdditionalSettlementRequestPayload"/>
    <xs:complexType name="AdditionalSettlementRequestPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>6.10.1.1. Payload Przekazanie rozliczenia dodatkowego</unk_6_10_1_1:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Rekord operacji masowej -->
            <xs:element name="AdditionalSettlement" type="unk_6_10_1_1:AdditionalSettlement" minOccurs="1" maxOccurs="1000">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Rekord operacji masowej</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-711</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Rekord operacji masowej                                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalSettlement" type="unk_6_10_1_1:AdditionalSettlement"/>
    <xs:complexType name="AdditionalSettlement">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Rekord operacji masowej</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-711</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator transakcji -->
            <xs:element name="ReferenceTransactionId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Identyfikator transakcji</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-710</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator rekordu nadawany przez Operatora, używany do korelacji rekordu żądania do rekordu wyniku</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier assigned by Operator, used for batch record identification</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="unk_6_10_1_1:DataSubject" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Przedmiot danych</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-160</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Informacje podstawowe -->
            <xs:element name="BasicData" type="unk_6_10_1_1:BasicData" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Informacje podstawowe</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-325</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Bonifikata -->
            <xs:element name="Discount" type="unk_6_10_1_1:Discount" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Bonifikata</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-398</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Opłata dodatkowa -->
            <xs:element name="AdditionalFee" type="unk_6_10_1_1:AdditionalFee" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Opłata dodatkowa</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-396</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Przedmiot danych                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="DataSubject" type="unk_6_10_1_1:DataSubject"/>
    <xs:complexType name="DataSubject">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Przedmiot danych</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-160</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Przedmiot danych -->
            <xs:element name="DataSubject" type="bdt:DataSubjectType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Przedmiot danych</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-161</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa, czy przekazywane lub udostępniane dane pomiarowe dotyczą Punktu pomiarowego, czy obiektu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether the transferred or shared metering data pertains to a Metering Point or a Metering Facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_6_10_1_1:MeteringPointData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Dane PP - ogólne</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-300</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane obiektu - ogólne -->
            <xs:element name="FacilityData_Basic" type="unk_6_10_1_1:FacilityData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Dane obiektu - ogólne</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-425</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.1.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_6_10_1_1:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Dane PP - ogólne</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-300</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Kod PP</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-001</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane obiektu - ogólne                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="FacilityData_Basic" type="unk_6_10_1_1:FacilityData_Basic"/>
    <xs:complexType name="FacilityData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Dane obiektu - ogólne</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-425</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Identyfikator obiektu</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-424</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Informacje podstawowe                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicData" type="unk_6_10_1_1:BasicData"/>
    <xs:complexType name="BasicData">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Informacje podstawowe</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-325</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Data i czas dokonania rozliczenia -->
            <xs:element name="BillingDateTime" type="xs:dateTime" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Data i czas dokonania rozliczenia</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-178</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Data i czas dokonania rozliczenia.</xs:documentation>
                    <xs:documentation xml:lang="en">Date and time of billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_rozliczenia -->
            <xs:element name="BillingIdentifier" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>ID_rozliczenia</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-226</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy identyfikator rozliczenia danego PPE, nadawany przez OSD.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique identifier of the billing of a given PPE, assigned by the DSO.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_rozliczenia_wzajemnego_OSD-SE -->
            <xs:element name="DsoSupplierSettlementIdentifier" type="bdt:String50_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>ID_rozliczenia_wzajemnego_OSD-SE</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-224</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator dokumentu (faktury zbiorczej/zagregowanej lub noty uznaniowej), wystawianej przez Operatora dla SE z tytułu usług dystrybucyjnych świadczonych przez Operatora na rzecz Użytkowników z którymi SE ma zawarte umowy kompleksowe, w którym uwzględnione jest dane rozliczenie</xs:documentation>
                    <xs:documentation xml:lang="en">Identifier of the document (summary/aggregate invoice or credit note), issued by the Operator to the Energy Supplier for distribution services provided by the Operator to Users with whom the ES has concluded comprehensive agreements, in which the billing in question is included</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ rozliczenia dodatkowego -->
            <xs:element name="AdditionalBillingType" type="bdt:AdditionalBillingType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Typ rozliczenia dodatkowego</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-372</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy komunikat dotyczy bonifikaty, czy opłaty dodatkowej.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the message concerns a discount or an additional charge.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy korekta komunikatu? -->
            <xs:element name="IsCorrection" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Czy korekta komunikatu?</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-195</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Informacja, czy komunikat jest korektą komunikatu.</xs:documentation>
                    <xs:documentation xml:lang="en">Information on whether the message is a correction of the message.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna korekty rozliczenia dodatkowego -->
            <xs:element name="AdditionalBillingCorrectionReason" type="bdt:AdditionalBillingCorrectionReasonType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Przyczyna korekty rozliczenia dodatkowego</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-373</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wskazanie przyczyny korekty komunikatu z rozliczeniem dodatkowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Indication of the reason for correction of the message with additional billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Korekta rozliczenia dodatkowego -->
            <xs:element name="AdditionalBillingCorrection" type="unk_6_10_1_1:AdditionalBillingCorrection" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Korekta rozliczenia dodatkowego</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-399</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Korekta rozliczenia dodatkowego                                                                                                              ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="AdditionalBillingCorrection" type="unk_6_10_1_1:AdditionalBillingCorrection"/>
    <xs:complexType name="AdditionalBillingCorrection">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Korekta rozliczenia dodatkowego</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-399</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Wartość korygowanego rozliczenia -->
            <xs:element name="ValueOfCorrectedBilling" type="bdt:PriceType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Wartość korygowanego rozliczenia</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-374</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Podsumowanie korygowanego rozliczenia (netto, jeśli opodatkowana VAT).</xs:documentation>
                    <xs:documentation xml:lang="en">Summary of the adjusted billing (net, if subject to VAT).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- ID_korygowanego_rozliczenia -->
            <xs:element name="CorrectedBillingIdentifier" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>ID_korygowanego_rozliczenia</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-354</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Identyfikator ID_rozliczenia, który jest przedmiotem korekty, określony przez nadawcę korygowanego komunikatu.</xs:documentation>
                    <xs:documentation xml:lang="en">ID of the ID_billing that is the subject of the correction, specified by the sender of the message being corrected.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Bonifikata                                                                                                                                   ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Discount" type="unk_6_10_1_1:Discount"/>
    <xs:complexType name="Discount">
        <xs:annotation>
            <xs:appinfo>
                <unk_6_10_1_1:plName>Bonifikata</unk_6_10_1_1:plName>
                <unk_6_10_1_1:code>PL-398</unk_6_10_1_1:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ bonifikaty -->
            <xs:element name="DiscountType" type="bdt:DiscountType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Typ bonifikaty</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-294</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określa typ bonifikaty - zgodnie z rozporządzeniem systemowym/taryfowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determines the type of discount - according to the system/tariff regulation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wyliczenie bonifikaty -->
            <xs:element name="DiscountCalculation" type="unk_6_10_1_1:DiscountCalculation" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_6_10_1_1:plName>Wyliczenie bonifikaty</unk_6_10_1_1:plName>
                        <unk_6_10_1_1:code>PL-397</unk_6_10_1_1:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wyliczenie bonifikaty                                                                                                                        ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="DiscountCalculation" type="unk_6_10_1_1:DiscountCalculation"/>
    <xs:complexType name="DiscountCalculation">
        <xs:annotation>
            <xs:appinfo>
