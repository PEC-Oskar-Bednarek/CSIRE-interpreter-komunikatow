    <xs:element name="AgreementRejectionFromStatementOfWillNotification" type="unk_2_5_1_2:AgreementRejectionFromStatementOfWillNotification"/>
    <xs:complexType name="AgreementRejectionFromStatementOfWillNotification">
        <xs:annotation>
