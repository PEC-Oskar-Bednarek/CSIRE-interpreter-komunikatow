    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_2_5_1_2:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_2_5_1_2:plName>Pozostałe elementy komunikatu</unk_2_5_1_2:plName>
                <unk_2_5_1_2:code>PL-320</unk_2_5_1_2:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_2:plName>ID_instancji_procesu_referencyjnego</unk_2_5_1_2:plName>
                        <unk_2_5_1_2:code>PL-002</unk_2_5_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu nadawany przez CSIRE dla uruchomionego procesu 1.1.</xs:documentation>
                    <xs:documentation xml:lang="en">Unique process instance code assigned by CSIRE for the running process 1.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przyczyna odmowy -->
            <xs:element name="RejectionReason" type="bdt:String10_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_2:plName>Przyczyna odmowy</unk_2_5_1_2:plName>
                        <unk_2_5_1_2:code>PL-136</unk_2_5_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Przyczyna odmowy realizacji zgłoszenia.</xs:documentation>
                    <xs:documentation xml:lang="en">The reason for the denial of the request.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dodatkowe pole opisowe -->
            <xs:element name="Description" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_2:plName>Dodatkowe pole opisowe</unk_2_5_1_2:plName>
                        <unk_2_5_1_2:code>PL-249</unk_2_5_1_2:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Uzupełniany, jeżeli brak możliwości realizacji nie jest możliwy do określenia zgodnie z listą.</xs:documentation>
                    <xs:documentation xml:lang="en">Completed if the failure to complete is not possible to determine according to the list.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
