            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_2:plName>Nagłówek</unk_2_5_1_2:plName>
                        <unk_2_5_1_2:code>PL-700</unk_2_5_1_2:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_2_5_1_2:plName>Kontekst</unk_2_5_1_2:plName>
                        <unk_2_5_1_2:code>PL-715</unk_2_5_1_2:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 2.5.1.2. Payload Powiadomienie o odmowie zawarcia UD na podstawie OŚW -->
            <xs:element name="Payload" type="unk_2_5_1_2:AgreementRejectionFromStatementOfWillNotificationPayload" minOccurs="1" maxOccurs="1">
