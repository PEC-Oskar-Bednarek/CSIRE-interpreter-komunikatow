<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bdt="urn:pl:oire:businessDataTypes:v1" xmlns:tech="urn:pl:oire:technical:v1" xmlns:unk_4_2_1_3="urn:pl:oire:unk_4_2_1_3:v1" elementFormDefault="qualified" targetNamespace="urn:pl:oire:unk_4_2_1_3:v1">
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Wersja z 08.12.2025                                                                                                                          ==== -->
    <!-- ====================================================================================================================================================== -->
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Import                                                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:import namespace="urn:pl:oire:businessDataTypes:v1" schemaLocation="businessDataTypes.xsd"/>
    <xs:import namespace="urn:pl:oire:technical:v1" schemaLocation="technical.xsd"/>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.2.1.3. Powiadomienie o paszporcie PP                                                                                                       ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicMeteringPointDataNotification" type="unk_4_2_1_3:BasicMeteringPointDataNotification"/>
    <xs:complexType name="BasicMeteringPointDataNotification">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>4.2.1.3. Powiadomienie o paszporcie PP</unk_4_2_1_3:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Nagłówek -->
            <xs:element name="Header" type="tech:Header" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Nagłówek</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-700</unk_4_2_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- Kontekst -->
            <xs:element name="ProcessEnergyContext" type="tech:ProcessEnergyContext" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Kontekst</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-715</unk_4_2_1_3:code>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
            
            <!-- 4.2.1.3. Payload Powiadomienie o paszporcie PP -->
            <xs:element name="Payload" type="unk_4_2_1_3:BasicMeteringPointDataNotificationPayload" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>4.2.1.3. Payload Powiadomienie o paszporcie PP</unk_4_2_1_3:plName>
                    </xs:appinfo>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== 4.2.1.3. Payload Powiadomienie o paszporcie PP                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BasicMeteringPointDataNotificationPayload" type="unk_4_2_1_3:BasicMeteringPointDataNotificationPayload"/>
    <xs:complexType name="BasicMeteringPointDataNotificationPayload">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>4.2.1.3. Payload Powiadomienie o paszporcie PP</unk_4_2_1_3:plName>
            </xs:appinfo>
        </xs:annotation>
        <xs:sequence>
            <!-- Pozostałe elementy komunikatu -->
            <xs:element name="Miscellaneous" type="unk_4_2_1_3:Miscellaneous" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Pozostałe elementy komunikatu</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-320</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - ogólne -->
            <xs:element name="MeteringPointData_Basic" type="unk_4_2_1_3:MeteringPointData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Dane PP - ogólne</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-300</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - ogólne -->
            <xs:element name="TechnicalData_Basic" type="unk_4_2_1_3:TechnicalData_Basic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - ogólne</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-304</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Własność elementów układu pomiarowo-rozliczeniowego -->
            <xs:element name="MeasurementAndBillingCircuitOwnership" type="unk_4_2_1_3:MeasurementAndBillingCircuitOwnership" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Własność elementów układu pomiarowo-rozliczeniowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-310</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry handlowe - ogólne -->
            <xs:element name="BusinessData_Basic" type="unk_4_2_1_3:BusinessData_Basic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry handlowe - ogólne</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-316</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 5.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Pozostałe elementy komunikatu                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="Miscellaneous" type="unk_4_2_1_3:Miscellaneous"/>
    <xs:complexType name="Miscellaneous">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Pozostałe elementy komunikatu</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-320</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- ID_instancji_procesu_referencyjnego -->
            <xs:element name="ProcessInstanceId" type="bdt:UuidType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>ID_instancji_procesu_referencyjnego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-002</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikatowy kod instancji procesu referencyjnego komunikatu, nadawany przez CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">The unique process instance code of the message reference process, assigned by CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Przypisanie Użytkownika KSE -->
            <xs:element name="HasAssignedKseUser" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Przypisanie Użytkownika KSE</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-165</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Atrybut wynikający z aktualnej charakterystyki PP. Wskazuje czy dla danego PP przypisany jest Użytkownik KSE.</xs:documentation>
                    <xs:documentation xml:lang="en">Attribute resulting from current MP characteristics. Indicates whether an KSE User is assigned for a given MP.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - ogólne                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Basic" type="unk_4_2_1_3:MeteringPointData_Basic"/>
    <xs:complexType name="MeteringPointData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Dane PP - ogólne</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-300</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kod PP -->
            <xs:element name="MeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Kod PP</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-001</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Metering Point Identification Code - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Typ Punktu pomiarowego -->
            <xs:element name="MeteringPointType" type="bdt:MeteringPointType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Typ Punktu pomiarowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-053</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu Punktu pomiarowego, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the Metering Point type, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Charakter PPE -->
            <xs:element name="MpApType" type="bdt:MpApType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Charakter PPE</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-056</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie charakteru Punktu poboru energii, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the nature of the Energy Consumption Point, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Charakter PPI -->
            <xs:element name="MpOtherType" type="bdt:MpOtherType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Charakter PPI</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-419</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie charakteru Punktu pomiarowego inny, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the nature of the Metering Point other, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy PP podrzędny względem innego PP? -->
            <xs:element name="IsChildMp" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Czy PP podrzędny względem innego PP?</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-418</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy wskazany Punkt pomiarowy jest autonomiczny, czy jest podrzędny względem innego Punktu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the indicated Metering Point is autonomous or is subordinate to another Metering Point.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod nadrzędnego PP -->
            <xs:element name="ParentMeteringPointCode" type="bdt:MeteringPointCodeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Kod nadrzędnego PP</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-420</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod identyfikujący Punkt pomiarowy nadrzędny wobec zgłaszanego PP - zgodny ze standardem GS1.</xs:documentation>
                    <xs:documentation xml:lang="en">Code identifying the Metering Point superior to the reported MP - compliant with the GS1 standard.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy PP wchodzi w skład obiektu? -->
            <xs:element name="IsMpPartOfFacility" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Czy PP wchodzi w skład obiektu?</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-421</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dany Punkt pomiarowy jest elementem obiektu pomiarowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of whether a given Metering Point is part of a metering facility.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - obiekt -->
            <xs:element name="MeteringPointData_Facility" type="unk_4_2_1_3:MeteringPointData_Facility" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Dane PP - obiekt</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-422</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Dane PP - adresowe -->
            <xs:element name="MeteringPointData_Address" type="unk_4_2_1_3:MeteringPointData_Address" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Dane PP - adresowe</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-301</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - obiekt                                                                                                                             ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Facility" type="unk_4_2_1_3:MeteringPointData_Facility"/>
    <xs:complexType name="MeteringPointData_Facility">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Dane PP - obiekt</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-422</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ obiektu -->
            <xs:element name="FacilityType" type="bdt:FacilityType_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Typ obiektu</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-423</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie typu obiektu, zgodnie ze słownikiem.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination of the facility type, according to the dictionary.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Identyfikator obiektu -->
            <xs:element name="FacilityIdentifier" type="bdt:FacilityIdentifierType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Identyfikator obiektu</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-424</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Unikalny kod identyfikujący obiekt pomiarowy. Struktura Identyfikatora obiektu składa się z:
1) kodu EIC (np. 19X000000000001C),
2) oznaczenia przedmiotu identyfikacji (OP - obiektu pomiarowego),
3) unikalnego dopełnienia nadawanego przez Operatora (np. 11111111).</xs:documentation>
                    <xs:documentation xml:lang="en">Unique code identifying the metering facility. The structure of the facility Identifier consists of:
1) EIC code (e.g. 19X000000000001C),
2) designation of the facility of identification (OP - measurement facility),
3) a unique complement assigned by the Operator (e.g. 11111111).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Dane PP - adresowe                                                                                                                           ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeteringPointData_Address" type="unk_4_2_1_3:MeteringPointData_Address"/>
    <xs:complexType name="MeteringPointData_Address">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Dane PP - adresowe</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-301</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 2.2.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Kraj -->
            <xs:element name="Country" type="bdt:CountryIsoCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Kraj</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-003</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod kraju zgodny z ISO 3166-1 alpha-2</xs:documentation>
                    <xs:documentation xml:lang="en">Country code in accordance with ISO 3166-1 alpha-2</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejscowość -->
            <xs:element name="CityName" type="bdt:String50_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Miejscowość</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-004</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa miejscowości (właściwa dla Punktu pomiarowego).</xs:documentation>
                    <xs:documentation xml:lang="en">Name of the city (specific to the Metering Point).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy zastosowano podział na ulice? -->
            <xs:element name="IsStreetSeparationPresent" type="xs:boolean" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Czy zastosowano podział na ulice?</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-558</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danego adresu PP w miejscowości zastosowano podział na ulice.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether street division is applicable for this MP address</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy ulica zgodna z TERYT? -->
            <xs:element name="IsStreetTerytCodeAvailable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Czy ulica zgodna z TERYT?</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-584</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dla danej ulicy istnieje kod TERYT</xs:documentation>
                    <xs:documentation xml:lang="en">Determines whether a TERYT code exists for a given street</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Kod pocztowy -->
            <xs:element name="PostalCode" type="bdt:PostalCodeType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Kod pocztowy</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-005</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Kod pocztowy</xs:documentation>
                    <xs:documentation xml:lang="en">Postal code</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Ulica -->
            <xs:element name="StreetName" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Ulica</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-006</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Nazwa ulicy albo nazwa miejscowości, w przypadku miejscowości bez zastosowanego podziału na ulice. Wprowadzona nazwa musi być zgodna z założeniami dla bazy adresowej TERYT, przy uwzględnieniu zasad implementacji słowników w zakresie katalogu ULIC. Jeżeli wynik połączenia cecha + nazwa_2 + nazwa_1 rozpoczyna się "ul. " lub "ulica " to należy umieścić nazwę ulicy z pominięciem wskazanych przedrostków.</xs:documentation>
                    <xs:documentation xml:lang="en">The name of the street or the name of the city, in the case of a city without street division. The entered name must be consistent with the TERYT address database, taking into account the rules of master data implementation for the ULIC database. If the result of the combination of prefix + name_2 + name_1 begins with "ul. " or "ulica " then the street name must be included without those prefixes.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr budynku -->
            <xs:element name="BuildingNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Nr budynku</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-007</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer budynku</xs:documentation>
                    <xs:documentation xml:lang="en">Building number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr lokalu / mieszkania -->
            <xs:element name="ApartmentNumber" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Nr lokalu / mieszkania</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-008</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer lokalu/mieszkania</xs:documentation>
                    <xs:documentation xml:lang="en">Premises/apartment number</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr działki -->
            <xs:element name="PlotNumber" type="bdt:String100_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Nr działki</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-009</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer działki (w przypadku braku nazwy ulicy lub numeru budynku).</xs:documentation>
                    <xs:documentation xml:lang="en">Parcel number (in case there is no street name or building number).</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- TERYT -->
            <xs:element name="Teryt" type="bdt:TerytType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>TERYT</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-010</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Zgodny z Krajowym Rejestrem TERYT typy centralny katalog ulic (ULIC).</xs:documentation>
                    <xs:documentation xml:lang="en">Compliant with the National TERYT Register types central street directory (ULIC).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry techniczne - ogólne                                                                                                                ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="TechnicalData_Basic" type="unk_4_2_1_3:TechnicalData_Basic"/>
    <xs:complexType name="TechnicalData_Basic">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Parametry techniczne - ogólne</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-304</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Status przyłączenia PP -->
            <xs:element name="ConnectionStatus" type="bdt:MeteringPointConnectionStatusType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Status przyłączenia PP</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-095</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie statusu przyłączenia PP, wyróżniamy pięć statusów (UWAGA przy tworzeniu PP inicjalnie mogą być wskazane TYLKO pierwsze 3):
"W trakcie budowy" - gdzie kod PP został nadany, nie wszystkie parametry techniczne i dane PP zostały uzupełnione, nie można realizować umów na takim PP;
"Przyłączony" - warunki określone w umowie przyłączenia zostały zrealizowane oraz obiekt został przyłączony do sieci, PP jest dostępny dla rynku, tylko w tym przypadku jest możliwość realizacji umów sprzedaży i dystrybucji;
"Odłączony" - PP jest tymczasowo niedostępny dla rynku, nie ma możliwości zgłaszania nowych umów dla PP;
"Zlikwidowany" - PP jest trwale niedostępny dla rynku, obiekt został zlikwidowany, zburzony itp;
"Błędny" - stosowany wyłącznie do PP nieprawidłowo utworzonych w CSIRE.</xs:documentation>
                    <xs:documentation xml:lang="en">Determine the status of MP connection, there are five statuses (NOTE when creating a MP initially, ONLY the first 3 can be indicated):
"Under construction" - where the MP code has been assigned, not all technical parameters and MP data have been completed, agreements cannot be executed on such MP;
"Connected" - the conditions specified in the connection agreement have been fulfilled and the facility has been connected to the network, the MP is available to the market, only in this case it is possible to execute supply and distribution agreement;
"Disconnected" - MP is temporarily unavailable to the market, it is not possible to submit new agreements for MP;
"Decommissioned" - MP is permanently unavailable to the market, the facility has been decommissioned, demolished, etc.;
"Incorrect" - applied only to MPs incorrectly created in CSIRE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Poziom napięcia w miejscu dostarczania -->
            <xs:element name="MeteringPointElectricityVoltageLevel" type="bdt:MeasurementCircuitVoltageLevelType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Poziom napięcia w miejscu dostarczania</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-092</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Poziom napięcia w miejscu dostarczania.</xs:documentation>
                    <xs:documentation xml:lang="en">Voltage level at the point of delivery.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Fazowość układu pomiarowego -->
            <xs:element name="MeasuringSystemPhasesCount" type="bdt:MeasuringSystemPhasesCountType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Fazowość układu pomiarowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-093</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Fazowość układu pomiarowo-rozliczeniowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Phasing of the metering and billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Minimalna moc umowna -->
            <xs:element name="MinContractedPower" type="bdt:PowerKiloWattsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Minimalna moc umowna</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-110</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość minimalnej mocy umownej, wyrażona w [kW].</xs:documentation>
                    <xs:documentation xml:lang="en">The value of the minimum contracted capacity, expressed in [kW].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Maksymalna moc umowna -->
            <xs:element name="MaxContractedPower" type="bdt:PowerKiloWattsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Maksymalna moc umowna</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-111</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość maksymalnej mocy umownej, wyrażona w [kW].</xs:documentation>
                    <xs:documentation xml:lang="en">The value of the maximum contracted power, expressed in [kW].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Grupa przyłączeniowa -->
            <xs:element name="ConnectionGroup" type="bdt:ConnectionGroupType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Grupa przyłączeniowa</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-101</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Grupa przyłączeniowa</xs:documentation>
                    <xs:documentation xml:lang="en">Connection group</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Data obowiązywania warunków przyłączeniowych -->
            <xs:element name="DateOfValidityOfTheConnectionConditions" type="xs:date" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Data obowiązywania warunków przyłączeniowych</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-098</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określana jedynie dla VI gr. przyłączeniowej, wskazuje ostatni dzień warunków przyłączenia.</xs:documentation>
                    <xs:documentation xml:lang="en">Specified only for the VI connection gr. and indicates the last day of the connection conditions.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Moc przyłączeniowa -->
            <xs:element name="ConnectionPower" type="bdt:PowerKiloWattsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Moc przyłączeniowa</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-102</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość mocy przyłączeniowej, wyrażona w [kW].</xs:documentation>
                    <xs:documentation xml:lang="en">The value of the connection power, expressed in [kW].</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejsce dostarczania energii -->
            <xs:element name="PlaceOfEnergySupply" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Miejsce dostarczania energii</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-103</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Miejsce dostarczania energii</xs:documentation>
                    <xs:documentation xml:lang="en">Place of energy supply</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejsce rozgraniczenia własności urządzeń -->
            <xs:element name="DeviceOwnershipSeparationLocation" type="bdt:String250_Type" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Miejsce rozgraniczenia własności urządzeń</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-104</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Miejsce rozgraniczenia własności urządzeń.</xs:documentation>
                    <xs:documentation xml:lang="en">Place of separation of ownership of equipment.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Miejsce zainstalowania układu pomiarowo-rozliczeniowego -->
            <xs:element name="PlaceOfInstallationOfMeteringAndBillingSystem" type="bdt:String250_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Miejsce zainstalowania układu pomiarowo-rozliczeniowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-515</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Miejsce zainstalowania układu pomiarowo-rozliczeniowego.</xs:documentation>
                    <xs:documentation xml:lang="en">Place of installation of the metering and billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Współczynnik pewności zasilania -->
            <xs:element name="PowerReliabilityFactor" type="bdt:PowerReliabilityFactorType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Współczynnik pewności zasilania</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-112</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Współczynnik odzwierciedlający specyfikę układu zasilania Użytkownika KSE. Domyślna wartość współczynnika równa się 1.</xs:documentation>
                    <xs:documentation xml:lang="en">A factor reflecting the specifics of the KSE User's power system. The default value of the coefficient is equal to 1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Wartość zabezpieczenia przed licznikowego -->
            <xs:element name="FuseSize" type="bdt:FuseSizeType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Wartość zabezpieczenia przed licznikowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-094</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość zabezpieczenia przed licznikowego, wyrażona w [A]. Atrybut obsługujący również przypadek zabezpieczenia dla grupy taryfowej R - Ryczałt.
W przypadku układów pomiarowo-rozliczeniowych półpośrednich i pośrednich należy wprowadzić zero "0".</xs:documentation>
                    <xs:documentation xml:lang="en">The value of pre-meter protection, expressed in [A]. The attribute also supports the case of R tariff group - Lump Sum.
In the case of semi-direct and indirect metering and billing systems, zero value should be used "0".</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Czy posiada dodatkowe nośniki energii? -->
            <xs:element name="HasAdditionalEnergyCarriers" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Czy posiada dodatkowe nośniki energii?</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-543</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie, czy dany Punkt poboru energii posiada dodatkowe nośniki energii, niewynikające z Charakteru PPE.</xs:documentation>
                    <xs:documentation xml:lang="en">Determination whether the Energy Point has additional energy carriers, not arising from the Nature of the PPE.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - licznik -->
            <xs:element name="TechnicalData_Meter" type="unk_4_2_1_3:TechnicalData_Meter" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - licznik</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-305</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - analizator JEE -->
            <xs:element name="TechnicalData_EeqValidator" type="unk_4_2_1_3:TechnicalData_EeqValidator" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - analizator JEE</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-517</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.2.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - przekładniki -->
            <xs:element name="TechnicalData_Transformers" type="unk_4_2_1_3:TechnicalData_Transformers" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - przekładniki</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-306</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - straty -->
            <xs:element name="TechnicalData_Losses" type="unk_4_2_1_3:TechnicalData_Losses" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - straty</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-307</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.4.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - nośniki energii -->
            <xs:element name="TechnicalData_EnergyCarriers" type="unk_4_2_1_3:TechnicalData_EnergyCarriers" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - nośniki energii</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-544</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.5.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry techniczne - licznik                                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="TechnicalData_Meter" type="unk_4_2_1_3:TechnicalData_Meter"/>
    <xs:complexType name="TechnicalData_Meter">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Parametry techniczne - licznik</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-305</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Typ układu pomiarowo-rozliczeniowego -->
            <xs:element name="MeasurementAndBillingCircuitType" type="bdt:MeasurementAndBillingCircuitType_Type" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Typ układu pomiarowo-rozliczeniowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-096</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Określenie jakie wymagania, zawarte w rozporządzeniu w sprawie systemu pomiarowego, spełnia układ pomiarowo-rozliczeniowy zainstalowany w danym PP.
Kod CK0201 dotyczy układów spełniających wszystkie wymogi rozporządzenia ws. systemu pomiarowego.
Kody CK0202 i CK0203 oznaczają układy częściowo spełniające wymogi tego rozporządzenia (np. posiadające zdalną transmisję danych, ale nieposiadające stycznika).
Wartości CK0201 dla kategorii C1 lub CK0202, gdy komunikacja LZO=True i metoda pomiaru=E13 tego atrybutu, oznaczają możliwość uruchomienia rozliczenia PPE w trybie przedpłatowym.</xs:documentation>
                    <xs:documentation xml:lang="en">Determining what requirements contained in the regulation on the measurement system are met by the measurement and billing system installed in a given MP.
The CK0201 code applies to systems that meet all the requirements of the measurement system regulation.
The CK0202 and CK0203 codes refer to systems that partially meet the requirements of this regulation (e.g. with remote data transmission, but without a contactor).
The values CK0201 for C1 category and CK0202 (only when IsSmartMeterConnected=True and measurement method=E13) of this attribute indicate the possibility of starting PPE billing in the prepayment mode.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Komunikacja LZO -->
            <xs:element name="IsSmartMeterConnected" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Komunikacja LZO</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-058</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Atrybut określa, czy Operator skomunikował licznik zdalnego odczytu z systemem pomiarowym, w sposób umożliwiający wymianę informacji wynikającą z rozporządzenia w sprawie systemu pomiarowego. Atrybut ten powinien być określony statycznie, nie referować do tymczasowej utraty komunikacji z LZO. Atrybut ten jest informacją dla SE o możliwości zarządzania dostarczaniem en.el. w PPE oraz możliwością uruchomienia rozliczenia PPE w trybie przedpłatowym.</xs:documentation>
                    <xs:documentation xml:lang="en">The attribute specifies whether the Operator has communicated the remote reading meter with the metering system, in a way that allows the exchange of information resulting from the Metering System Regulation. This attribute should be determined statically, not refer to a temporary loss of communication with the Smart Meter. This attribute is information to the ES about the ability to manage the supply of electrical energy in the PPE and the ability to trigger PPE prepayment billing.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Nr licznika -->
            <xs:element name="MeterNumber" type="bdt:MeterNumberType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Nr licznika</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-097</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Numer seryjny podstawowego licznika energii czynnej.</xs:documentation>
                    <xs:documentation xml:lang="en">Serial number of the primary active energy meter.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Poziom napięcia zainstalowania układu pomiarowego -->
            <xs:element name="MeteringSystemInstallationVoltageLevel" type="bdt:MeasurementCircuitVoltageLevelType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Poziom napięcia zainstalowania układu pomiarowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-091</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Poziom napięcia zainstalowania układu pomiarowo-rozliczeniowego.</xs:documentation>
                    <xs:documentation xml:lang="en">The voltage level of the installation of the metering and billing system.</xs:documentation>
                </xs:annotation>
            </xs:element>
            
            <!-- Parametry licznika - rejestry pomiarowe -->
