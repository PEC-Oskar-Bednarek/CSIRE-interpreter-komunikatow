    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry licznika - rejestry pomiarowe                                                                                                      ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="MeterData_Registers" type="unk_4_2_1_3:MeterData_Registers"/>
    <xs:complexType name="MeterData_Registers">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Parametry licznika - rejestry pomiarowe</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-119</unk_4_2_1_3:code>
