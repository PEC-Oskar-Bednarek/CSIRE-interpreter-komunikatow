                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - straty biegu jałowego</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-356</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.4.3.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    
