                </xs:annotation>
            </xs:element>
            
            <!-- Parametry techniczne - straty licznikowe -->
            <xs:element name="TechnicalData_MeterLosses" type="unk_4_2_1_3:TechnicalData_MeterLosses" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Parametry techniczne - straty licznikowe</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-537</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Sekcja 3.4.2.</xs:documentation>
