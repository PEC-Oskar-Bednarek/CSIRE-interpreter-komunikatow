    <xs:element name="TechnicalData_PercentLosses" type="unk_4_2_1_3:TechnicalData_PercentLosses"/>
    <xs:complexType name="TechnicalData_PercentLosses">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Parametry techniczne - straty procentowe</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-536</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 3.4.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Wartość strat % mocy -->
            <xs:element name="EnergyLossValue" type="bdt:PercentageType" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:appinfo>
                        <unk_4_2_1_3:plName>Wartość strat % mocy</unk_4_2_1_3:plName>
                        <unk_4_2_1_3:code>PL-115</unk_4_2_1_3:code>
                    </xs:appinfo>
                    <xs:documentation xml:lang="pl">Wartość strat procentowych mocy, można podać wartości dodatnie i ujemne.</xs:documentation>
