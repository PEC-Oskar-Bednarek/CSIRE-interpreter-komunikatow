    <!-- ====================================================================================================================================================== -->
    <!-- ==== Parametry handlowe - warunki świadczenia usług                                                                                               ==== -->
    <!-- ====================================================================================================================================================== -->
    <xs:element name="BusinessData_TermsOfService" type="unk_4_2_1_3:BusinessData_TermsOfService"/>
    <xs:complexType name="BusinessData_TermsOfService">
        <xs:annotation>
            <xs:appinfo>
                <unk_4_2_1_3:plName>Parametry handlowe - warunki świadczenia usług</unk_4_2_1_3:plName>
                <unk_4_2_1_3:code>PL-321</unk_4_2_1_3:code>
            </xs:appinfo>
            <xs:documentation xml:lang="pl">Sekcja 5.1.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <!-- Grupa taryfowa -->
            <xs:element name="TariffGroup" type="bdt:String10_Type" minOccurs="0" maxOccurs="1">
